<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      插件自定义视图共享样式字典。
      所有颜色通过 DynamicResource 引用应用级 Token.* / MahApps 语义画刷，
      自动跟随明暗主题切换，替代各插件 XAML 中重复定义的硬编码亮色样式。
      用法：
        <UserControl.Resources>
          <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
        </UserControl.Resources>
    -->

    <!-- ======== 按钮 ======== -->
    <Style x:Key="Plugin.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Token.Primary}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Plugin.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Token.Surface.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Plugin.Button.DangerGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Token.Status.Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Status.Danger.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Token.Status.Danger.Background}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== 输入控件 ======== -->
    <Style x:Key="Plugin.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Token.Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Token.Primary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Plugin.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>

    <!-- ======== 文本 ======== -->
    <Style x:Key="Plugin.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Plugin.SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Token.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ======== 卡片容器 ======== -->
    <Style x:Key="Plugin.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ======== 分区标题：左侧强调条 + 标题 ======== -->
    <Style x:Key="Plugin.Section" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Token.Primary}"/>
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Plugin.SectionTitle2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ======== 图像预览宿主：HALCON 窗口外围框 ======== -->
    <Style x:Key="Plugin.PreviewHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Token.Surface.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ======== 列表行：悬停高亮 ======== -->
    <Style x:Key="Plugin.ListItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Token.Surface.Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======== 状态徽标 ======== -->
    <Style x:Key="Plugin.StatusChip.Success" TargetType="Border">
        <Setter Property="Background" Value="#1422C55E"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Plugin.StatusChip.Success.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#16A34A"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Plugin.StatusChip.Failed" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Token.Status.Danger.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Token.Status.Danger.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Plugin.StatusChip.Failed.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Token.Status.Danger}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ======== 辅助说明文本 ======== -->
    <Style x:Key="Plugin.Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>


    <!-- ==================== 紧凑页签（算子参数面板专用） ==================== -->
    <Style x:Key="Plugin.TabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 页签头：底部 2px 主色指示条 -->
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            BorderBrush="{DynamicResource Token.Border.Subtle}"
                            BorderThickness="0,0,0,1">
                            <TabPanel
                                IsItemsHost="True"
                                Background="Transparent"/>
                        </Border>
                        <!-- 页内容 -->
                        <ContentPresenter
                            Grid.Row="1"
                            ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Token.Text.Muted}"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="headerBorder"
                                        Grid.Row="0"
                                        Padding="10,4"
                                        Background="Transparent"
                                        CornerRadius="4,4,0,0">
                                        <ContentPresenter
                                            ContentSource="Header"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                                    </Border>
                                    <Border
                                        x:Name="indicator"
                                        Grid.Row="1"
                                        Background="Transparent"
                                        CornerRadius="1"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="headerBorder" Property="Background" Value="{DynamicResource Token.Surface.Muted}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="indicator" Property="Background" Value="{DynamicResource Token.Primary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Token.Text.Primary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
