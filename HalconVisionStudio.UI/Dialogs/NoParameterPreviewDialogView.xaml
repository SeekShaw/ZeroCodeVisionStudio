<UserControl
    x:Class="HalconVisionStudio.UI.Dialogs.NoParameterPreviewDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HalconVisionStudio.Shared;assembly=HalconVisionStudio.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:NoParameterPreviewDialogViewModel}}"
    d:DesignHeight="520"
    d:DesignWidth="860"
    MinHeight="420"
    MinWidth="680"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 圆角小徽标（分类） -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Opacity" Value="0.14" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：算子标题栏 ==================== -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    Margin="0,0,12,0"
                    CornerRadius="8"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Opacity="0.9">
                    <Path
                        Width="18"
                        Height="18"
                        Margin="4"
                        Data="{Binding OperatorIcon}"
                        Stretch="Uniform"
                        Stroke="White"
                        StrokeThickness="1.2" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                    Text="{Binding DialogTitle}" />

                <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource ChipStyle}" VerticalAlignment="Center"
                        Visibility="{Binding CategoryText, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding CategoryText}" />
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 中部：图像预览 + 引导说明 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="240" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：图像预览 -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                ClipToBounds="True">
                <ContentControl Content="{Binding HWindow}" />
            </Border>

            <!-- 右侧：空状态引导 -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1,0,0,0">
                <StackPanel Margin="16" VerticalAlignment="Center">
                    <Path HorizontalAlignment="Center" Width="38" Height="38" Data="{StaticResource Icon.Sliders}" Style="{StaticResource ToolbarIconPathStyle}" Opacity="0.55" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="Medium"
                        Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                        Text="此算子无需参数设置"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource MahApps.Brushes.Gray4}"
                        Text="点击下方「执行预览」查看处理结果"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 底部：状态条 + 操作栏 ==================== -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    MaxHeight="68"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal">
                        <Path VerticalAlignment="Top" Width="13" Height="13" Data="{StaticResource Icon.Bulb}" Style="{StaticResource ToolbarIconPathStyle}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Button
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ExecuteCommand}"
                    Content="执行预览" />

                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseCommand}"
                    Content="关闭" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
