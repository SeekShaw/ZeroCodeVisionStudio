<UserControl
    x:Class="HalconVisionStudio.UI.Dialogs.ShapeDrawDialogView"
    x:Name="drawRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HalconVisionStudio.Shared;assembly=HalconVisionStudio.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ShapeDrawDialogViewModel}}"
    d:DesignHeight="520"
    d:DesignWidth="780"
    MinHeight="440"
    MinWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- 统一下拉（可编辑）模板 -->
        <DataTemplate x:Key="UnifiedComboTemplate">
            <ComboBox
                Style="{StaticResource AppComboBoxStyle}"
                IsEditable="True"
                ItemsSource="{Binding MergedComboItems}"
                SelectedItem="{Binding SelectedComboItem, Mode=TwoWay}"
                Text="{Binding ComboText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="─">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray4}" />
                                <Setter Property="FontSize" Value="10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <!-- 参数行：悬停高亮 + 底部分隔线 -->
        <Style x:Key="DrawParameterRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  HALCON 绘制窗口区域  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="6">
            <ContentControl Content="{Binding HWindow}" />
        </Border>

        <GridSplitter
            Grid.Row="0"
            Grid.Column="1"
            Width="6"
            Background="Transparent" />

        <!--  右侧参数面板  -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  绘制操作区：交互引导卡片  -->
            <Border
                Margin="0,0,0,10"
                Padding="12,10"
                Background="{DynamicResource Theme.Vision.Status.Running.Background}"
                BorderBrush="{DynamicResource Theme.Vision.Status.Running.Border}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Vision.Status.Running}"
                        Text="绘制形状" />
                    <Button
                        Margin="0,8,0,6"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding DrawCommand}"
                        Content="在图像上绘制" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                        Text="{Binding DrawHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  参数列表标题  -->
            <StackPanel Grid.Row="1" Margin="4,0,4,6" Orientation="Horizontal">
                <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0" Background="{DynamicResource MahApps.Brushes.Accent}" />
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                    Text="参数设置" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <!--  输入来源（slot 绑定，来自代码后台）  -->
                    <StackPanel Visibility="{Binding ElementName=drawRoot, Path=HasSlotBindings, Converter={StaticResource BoolVis}}">
                        <TextBlock Margin="4,0,0,6" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Text="输入来源" />
                        <ItemsControl ItemsSource="{Binding ElementName=drawRoot, Path=SlotBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource MahApps.Brushes.Gray10}" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Text="{Binding InputName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputName}" />
                                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="DisplayName" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                            <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" Content="清除" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,4,0,10" Background="{DynamicResource MahApps.Brushes.Gray8}" />
                    </StackPanel>

                    <!--  统一参数行  -->
                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DrawParameterRowStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Row="0" Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Margin="0,10,10,0"
                                            FontSize="11.5"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMergedItems}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource UnifiedComboTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock
                                            Grid.Row="1" Grid.Column="1"
                                            Margin="0,3,0,0"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource Theme.Vision.Status.Failed}"
                                            Text="{Binding ErrorMessage}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  底部操作栏  -->
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,12,0,0"
            Padding="12,10"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    MaxHeight="68"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal">
                        <Path VerticalAlignment="Top" Width="13" Height="13" Data="{StaticResource Icon.Bulb}" Style="{StaticResource ToolbarIconPathStyle}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetCommand}"
                    Content="重置" />
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ExecuteCommand}"
                    Content="执行预览" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
