<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:HalconVisionStudio.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- Theme Semantic Color Tokens -->
            <!-- Control Styles -->
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/ControlStyles.xaml" />
        <!-- Shell Styles -->
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/ShellStyles.xaml" />
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/CommandBarStyles.xaml" />
        <!-- Hal Operate Window Style -->
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/HalOperateWindow.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

</ResourceDictionary>
