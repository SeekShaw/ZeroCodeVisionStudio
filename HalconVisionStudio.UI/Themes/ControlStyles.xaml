<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls">

    <!-- Section Title Style -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Label Style -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Hint Text Style -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Error Text Style -->
    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="mahs:TextBoxHelper.ClearTextButton" Value="False" />
        <Setter Property="mahs:TextBoxHelper.UseFloatingWatermark" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ComboBox Style -->
    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="mahs:TextBoxHelper.UseFloatingWatermark" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Primary Button Style -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="mahs:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>

    <!-- Secondary Button Style -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="mahs:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>

    <!-- Browse Button Style -->
    <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="mahs:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>

    <!-- Small Button Style -->
    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="mahs:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>

    <!-- Danger Button Style -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Failed.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Status.Failed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Failed.Border}" />
        <Setter Property="mahs:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>

    <!-- CheckBox Style -->
    <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Slider Style -->
    <Style x:Key="AppSliderStyle" TargetType="Slider" BasedOn="{StaticResource MahApps.Styles.Slider}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Parameter Row Style -->
    <Style x:Key="ParameterRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Action Bar Style -->
    <Style x:Key="ActionBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.ActionBar.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Panel Header Style -->
    <Style x:Key="PanelHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Panel.HeaderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Halcon Viewport Border Style -->
    <Style x:Key="ViewportBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Viewport.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Callout Info Style -->
    <Style x:Key="CalloutInfoStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Running.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Running.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Result Card Style -->
    <Style x:Key="ResultCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Panel.SubtleBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Icon Button Style -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- TabItem Style -->
    <Style x:Key="AppTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

</ResourceDictionary>
