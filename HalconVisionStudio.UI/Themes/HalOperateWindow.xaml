<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:HalconVisionStudio.UI.Controls"
    xmlns:hal="http://schemas.mvtec.com/halcondotnet">
    <Style TargetType="{x:Type ctrls:HalOperateWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrls:HalOperateWindow}">
                    <Grid>
                        <Border Background="Transparent">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="PART_RECTANGLE1" Header="绘制矩形1" />
                                    <MenuItem x:Name="PART_RECTANGLE2" Header="绘制矩形2" />
                                    <MenuItem x:Name="PART_CIRCLE" Header="绘制圆形" />
                                    <Separator />
                                    <MenuItem x:Name="PART_CLEAR" Header="清除所有" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <hal:HSmartWindowControlWPF x:Name="PART_HWINDOW" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

