<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panels and Background -->
    <SolidColorBrush x:Key="Theme.Vision.Window.Background" Color="#18181B" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.Background" Color="#27272A" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.HeaderBackground" Color="#3F3F46" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.SubtleBackground" Color="#202023" />
    <SolidColorBrush x:Key="Theme.Vision.ActionBar.Background" Color="#202023" />
    <SolidColorBrush x:Key="Theme.Vision.Viewport.Background" Color="#0B0F19" />

    <!-- Borders and Lines -->
    <SolidColorBrush x:Key="Theme.Vision.Border" Color="#3F3F46" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Subtle" Color="#2E2E32" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Focus" Color="#60A5FA" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Text.Primary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Secondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Muted" Color="#71717A" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Inverse" Color="#0F172A" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Status.Success" Color="#22C55E" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Background" Color="#14532D" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Border" Color="#166534" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Failed" Color="#EF4444" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Background" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Border" Color="#991B1B" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Running" Color="#38BDF8" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Background" Color="#0C4A6E" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Border" Color="#075985" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Warning" Color="#F59E0B" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Background" Color="#78350F" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Border" Color="#92400E" />

    <!-- Canvas and Connection -->
    <SolidColorBrush x:Key="Theme.Vision.Canvas.Background" Color="#18181B" />
    <SolidColorBrush x:Key="Theme.Vision.Canvas.GridDot" Color="#3F3F46" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Line" Color="#52525B" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Selected" Color="#60A5FA" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="Theme.Vision.Overlay.Background" Color="#CC000000" />

    <!-- AI Copilot & Modern Semantic Tokens -->
    <SolidColorBrush x:Key="Token.Primary" Color="#3B82F6" />
    <SolidColorBrush x:Key="Token.Surface.Background" Color="#18181B" />
    <SolidColorBrush x:Key="Token.Surface.Card" Color="#27272A" />
    <SolidColorBrush x:Key="Token.Surface.Muted" Color="#3F3F46" />
    <SolidColorBrush x:Key="Token.Border.Subtle" Color="#3F3F46" />
    <SolidColorBrush x:Key="Token.Text.Primary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Token.Text.Secondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Token.Text.Muted" Color="#71717A" />
    <SolidColorBrush x:Key="Token.Status.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Token.Status.Danger.Border" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Token.Status.Danger.Background" Color="#450A0A" />

</ResourceDictionary>
