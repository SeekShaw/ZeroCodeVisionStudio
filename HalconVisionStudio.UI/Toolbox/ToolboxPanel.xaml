<UserControl
    x:Class="HalconVisionStudio.UI.Controls.ToolboxPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    Width="{Binding PanelWidth, ElementName=Root}"
    MinWidth="52"
    d:DesignHeight="720"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
            <Style x:Key="CollapsedOnlyStyle" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ExpandedOnlyStyle" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="27" />
                <Setter Property="Margin" Value="6,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.Pressed}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ToolboxIconTemplate">
                <Path
                    Width="18"
                    Height="18"
                    Data="{Binding IconData}"
                    Stretch="Uniform"
                    Stroke="{DynamicResource MahApps.Brushes.Accent}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </DataTemplate>

            <DataTemplate x:Key="OperatorTileTemplate">
                <Border
                    Width="142"
                    Height="32"
                    Margin="3"
                    Padding="8,0"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Cursor="Hand"
                    MouseLeftButtonDown="ToolboxItem_MouseLeftButtonDown"
                    PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                    ToolTip="{Binding HandleDescription}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Path
                                Width="12"
                                Height="12"
                                Data="{Binding IconGeometry}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource MahApps.Brushes.Accent}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.4" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{Binding HandleName}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </DataTemplate>
        </UserControl.Resources>
    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Border
            x:Name="CollapsedRail"
            Width="52"
            HorizontalAlignment="Left"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
            BorderThickness="0,0,1,0"
            MouseEnter="CollapsedRail_MouseEnter"
            MouseLeave="CollapsedRail_MouseLeave"
            Style="{StaticResource CollapsedOnlyStyle}">
            <DockPanel LastChildFill="True">
                <Button
                    Height="27"
                    Margin="6,6,6,2"
                    Click="SearchButton_Click"
                    DockPanel.Dock="Top"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="搜索算子（展开工具箱）">
                    <Path
                        Width="14"
                        Height="14"
                        Data="M8,2.5 A5.5,5.5 0 1 0 8,13.5 A5.5,5.5 0 1 0 8,2.5 M12.5,12.5 L15,15"
                        Stretch="Uniform"
                        Stroke="{DynamicResource MahApps.Brushes.Gray6}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.6" />
                </Button>
                <Button
                    Height="36"
                    Margin="6,0,6,8"
                    Click="TogglePanel_Click"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="展开工具箱">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M4,7 L20,7 M4,12 L20,12 M4,17 L20,17"
                        Stretch="Uniform"
                        Stroke="{DynamicResource MahApps.Brushes.Accent}"
                        StrokeEndLineCap="Round"
                        StrokeThickness="1.8" />
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Click="GroupButton_Click"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ToolboxIconTemplate}"
                                    MouseEnter="GroupButton_MouseEnter"
                                    Style="{StaticResource RailButtonStyle}"
                                    ToolTip="{Binding DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border
            x:Name="ExpandedMenu"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
            BorderThickness="1"
            CornerRadius="4"
            Style="{StaticResource ExpandedOnlyStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <!-- 搜索框：跨全部分组过滤算子（Esc 清空） -->
                <Border
                    Margin="8,8,8,4"
                    Padding="8,0"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <DockPanel>
                        <Path
                            Width="13"
                            Height="13"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            Data="M8,2.5 A5.5,5.5 0 1 0 8,13.5 A5.5,5.5 0 1 0 8,2.5 M12.5,12.5 L15,15"
                            DockPanel.Dock="Left"
                            Stretch="Uniform"
                            Stroke="{DynamicResource MahApps.Brushes.Gray6}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6" />
                        <TextBox
                            x:Name="SearchBox"
                            Height="28"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            KeyDown="SearchBox_KeyDown"
                            Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="按算子名称/分类/描述搜索，Esc 清空" />
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Groups, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border
                                        Height="34"
                                        Padding="8,0,8,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                        BorderThickness="0,0,0,1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="GroupRow_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.Pressed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                Width="8"
                                                Height="8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource MahApps.Brushes.Accent}"
                                                Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="M2,4 L8,10 L14,4 Z" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Data" Value="M2,10 L8,4 L14,10 Z" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="False">
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    Margin="6,0,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource MahApps.Brushes.Gray6}"
                                                    Text="{Binding Count, StringFormat={}{0} 项}" />
                                            </DockPanel>
                                            <Path
                                                Grid.Column="2"
                                                Width="17"
                                                Height="17"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="{Binding IconData}"
                                                Stretch="Uniform"
                                                Stroke="{DynamicResource MahApps.Brushes.Accent}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl
                                        Margin="14,6,10,8"
                                        ItemTemplate="{StaticResource OperatorTileTemplate}"
                                        ItemsSource="{Binding Handles}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                    BorderThickness="0,1,0,0">
                    <Button
                        Width="44"
                        Height="40"
                        HorizontalAlignment="Left"
                        Click="TogglePanel_Click"
                        Style="{StaticResource RailButtonStyle}"
                        ToolTip="收起工具箱">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M7,14 L4,20 L10,17 M10,17 L17,10 M14,4 L20,10 M12,6 L18,12 M13,5 L19,11 M8,9 L15,16"
                            Stretch="Uniform"
                            Stroke="{DynamicResource MahApps.Brushes.Accent}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6" />
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Popup
            AllowsTransparency="True"
            IsOpen="{Binding IsFlyoutOpen, ElementName=Root, Mode=TwoWay}"
            Placement="Right"
            PlacementTarget="{Binding ElementName=CollapsedRail}"
            PopupAnimation="Fade"
            StaysOpen="True">
            <Border
                x:Name="FlyoutPanel"
                Width="320"
                MaxHeight="380"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                BorderThickness="1"
                CornerRadius="4"
                MouseEnter="FlyoutPanel_MouseEnter"
                MouseLeave="FlyoutPanel_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="10,0,8,0">
                        <Path
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Data="{Binding SelectedGroup.IconData, ElementName=Root}"
                            DockPanel.Dock="Left"
                            Stretch="Uniform"
                            Stroke="{DynamicResource MahApps.Brushes.Accent}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                            Text="{Binding SelectedGroup.DisplayName, ElementName=Root}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="8,0,6,8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemTemplate="{StaticResource OperatorTileTemplate}" ItemsSource="{Binding SelectedGroup.Handles, ElementName=Root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>



