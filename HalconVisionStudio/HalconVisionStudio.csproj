<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HalconVisionStudio</AssemblyName>
    <RootNamespace>HalconVisionStudio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AAAandSphinx.MahApps.Metro" Version="3.0.0.2" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup> 
    <ProjectReference Include="..\HalconVisionStudio.AI\HalconVisionStudio.AI.csproj" />
    <ProjectReference Include="..\HalconVisionStudio.Core\HalconVisionStudio.Core.csproj" />
    <ProjectReference Include="..\HalconVisionStudio.Shared\HalconVisionStudio.Shared.csproj" />
    <ProjectReference Include="..\HalconVisionStudio.UI\HalconVisionStudio.UI.csproj" /> 
    <ProjectReference Include="..\Plugins\ContourProcessing\Plugin.Handle.ContourProcessing.csproj" />
    <ProjectReference Include="..\Plugins\DeviceCommunication\Plugin.Handle.DeviceCommunication.csproj" />
    <ProjectReference Include="..\Plugins\Geometry\Plugin.Handle.Geometry.csproj" />
    <ProjectReference Include="..\Plugins\GrayFeature\Plugin.Handle.GrayFeature.csproj" />
    <ProjectReference Include="..\Plugins\ImageInput\Plugin.Handle.ImageInput.csproj" />
    <ProjectReference Include="..\Plugins\Logic\Plugin.Handle.Logic\Plugin.Handle.Logic.csproj" />
    <ProjectReference Include="..\Plugins\Measurement\Plugin.Handle.Measurement.csproj" />
    <ProjectReference Include="..\Plugins\Preprocessing\Plugin.Handle.Preprocessing.csproj" />
    <ProjectReference Include="..\Plugins\RegionProcessing\Plugin.Handle.RegionProcessing.csproj" />
    <ProjectReference Include="..\Plugins\ResultOutput\Plugin.Handle.ResultOutput.csproj" />
    <ProjectReference Include="..\Plugins\Segmentation\Plugin.Handle.Segmentation.csproj" />
    <ProjectReference Include="..\Plugins\ShapeFeature\Plugin.Handle.ShapeFeature.csproj" />
    <ProjectReference Include="..\Plugins\ShapeMatching\Plugin.Handle.ShapeMatching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\libs\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- MCP stdio 桥接脚本随程序发布，供 Claude Code / Cursor 等外部 MCP 客户端挂载。 -->
  <ItemGroup>
    <None Include="..\halcon-mcp-bridge.py" Link="halcon-mcp-bridge.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
