<mahs:MetroWindow
    x:Class="HalconVisionStudio.Views.Communication.CommunicationManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comm="clr-namespace:HalconVisionStudio.Shared.Communication;assembly=HalconVisionStudio.Shared"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    Title="通讯驱动管理"
    Width="1000"
    Height="760"
    MinWidth="880"
    MinHeight="640"
    WindowStartupLocation="CenterOwner"
    FontFamily="Microsoft YaHei UI"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <mahs:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <DataTemplate DataType="{x:Type comm:TcpClientDriverConfig}">
                <StackPanel>
                    <TextBlock Text="TCP 客户端（主动连接远端设备）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="远端地址" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="远端端口" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="连接超时 (ms)" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <CheckBox Content="发送时断线自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,2,0,0"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:TcpServerDriverConfig}">
                <StackPanel>
                    <TextBlock Text="TCP 服务端（监听端口，下位机连入）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="监听端口" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="最大客户端数" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding MaxClients, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,8,0,0"
                               Text="发送时广播给全部已连接客户端；接收来自任一客户端。"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:UdpDriverConfig}">
                <StackPanel>
                    <TextBlock Text="UDP（无连接数据报）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="本地绑定端口（接收）" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="远端地址（发送，广播用 255.255.255.255）" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="远端端口（发送）" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:SerialDriverConfig}">
                <StackPanel>
                    <TextBlock Text="串口（RS232/485）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="端口名" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="波特率" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="校验位" Style="{StaticResource Plugin.Label}"/>
                            <ComboBox SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" Style="{StaticResource Plugin.ComboBox}" Margin="0,3,0,0">
                                <ComboBoxItem Content="无校验"/>
                                <ComboBoxItem Content="奇校验"/>
                                <ComboBoxItem Content="偶校验"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="停止位" Style="{StaticResource Plugin.Label}"/>
                            <ComboBox SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" Style="{StaticResource Plugin.ComboBox}" Margin="0,3,0,0">
                                <ComboBoxItem Content="一位"/>
                                <ComboBoxItem Content="两位"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="数据位" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type comm:ModbusTcpDriverConfig}">
                <StackPanel>
                    <TextBlock Text="Modbus TCP 主站（长连接事务化读写）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="PLC / 从站地址" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="端口（默认 502）" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="从站单元号 (UnitId)" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="连接超时 (ms)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="应答超时 (ms)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:ModbusRtuDriverConfig}">
                <StackPanel>
                    <TextBlock Text="Modbus RTU 主站（串口 + CRC16）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="端口名" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Text="波特率" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="校验位" Style="{StaticResource Plugin.Label}"/>
                            <ComboBox SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" Style="{StaticResource Plugin.ComboBox}" Margin="0,3,0,0">
                                <ComboBoxItem Content="无校验"/>
                                <ComboBoxItem Content="奇校验"/>
                                <ComboBoxItem Content="偶校验"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="停止位" Style="{StaticResource Plugin.Label}"/>
                            <ComboBox SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" Style="{StaticResource Plugin.ComboBox}" Margin="0,3,0,0">
                                <ComboBoxItem Content="一位"/>
                                <ComboBoxItem Content="两位"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="数据位" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="从站地址" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="应答超时 (ms)" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <TextBox Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:MqttDriverConfig}">
                <StackPanel>
                    <TextBlock Text="MQTT 客户端（发布/订阅）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="服务器地址" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="90">
                            <TextBlock Text="端口" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="用户名（可空）" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码（可空）" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="发布主题（发送目标）" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <TextBox Text="{Binding PublishTopic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}"/>
                    <TextBlock Text="订阅主题（# 通配，收到进入接收缓冲）" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <TextBox Text="{Binding SubscribeTopic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:WebSocketDriverConfig}">
                <StackPanel>
                    <TextBlock Text="WebSocket 客户端" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="服务端地址 (ws:// 或 wss://)" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:LoopbackDriverConfig}">
                <StackPanel>
                    <TextBlock Text="虚拟回环（无硬件调试）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="模拟接收延迟 (ms)" Style="{StaticResource Plugin.Label}"/>
                    <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                    <TextBlock Style="{StaticResource Plugin.Hint}" Text="发送的数据（延迟后）立即进入接收缓冲，用于调试通讯流程。"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:S7DriverConfig}">
                <StackPanel>
                    <TextBlock Text="西门子 S7（S7netplus，ISO-on-TCP）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PLC 地址" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="90">
                            <TextBlock Text="端口" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="CPU 类型" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <ComboBox SelectedIndex="{Binding CpuIndex, Mode=TwoWay}" Style="{StaticResource Plugin.ComboBox}">
                        <ComboBoxItem Content="S7-200"/>
                        <ComboBoxItem Content="S7-200 Smart"/>
                        <ComboBoxItem Content="S7-300"/>
                        <ComboBoxItem Content="S7-400"/>
                        <ComboBoxItem Content="S7-1200"/>
                        <ComboBoxItem Content="S7-1500"/>
                    </ComboBox>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="机架 (Rack)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="槽 (Slot)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="超时 (ms)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,10,0,0"
                               Text="算子地址示例：DB10.DBW0（DB 字）· DB10.DBX0.1（DB 位）· MW100 / MD100 / M100.3 · I50 / Q80"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:McDriverConfig}">
                <StackPanel>
                    <TextBlock Text="三菱 MELSEC MC 协议（4E 二进制帧，自实现）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PLC 地址" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="90">
                            <TextBlock Text="端口" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="网络号（默认 0）" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding NetworkNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PLC 号（默认 255）" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding PlcNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="模块 IO 号" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding ModuleIo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="站号" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding StationNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="超时 (ms)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,10,0,0"
                               Text="端口默认 5007（FX5U/Q-L 以太网模块）。地址示例：D100 / W100 / R100（字）· M100（位）· X1A / Y10 / B0（位，十六进制）。自实现协议，首用建议现场联机验证。"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type comm:FinsDriverConfig}">
                <StackPanel>
                    <TextBlock Text="欧姆龙 FINS/TCP（自实现）" Style="{StaticResource Plugin.SectionTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PLC 地址" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="90">
                            <TextBlock Text="端口" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本站节点(-1自动)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding LocalNode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PLC节点(-1自动)" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding DestNode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="网络号" Style="{StaticResource Plugin.Label}"/>
                            <TextBox Text="{Binding DestNetwork, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="超时 (ms)" Style="{StaticResource Plugin.Label}" Margin="0,8,0,3"/>
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Plugin.TextBox}"/>
                    <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,10,0,0"
                               Text="端口默认 9600；节点 -1 = 连接时由 PLC 自动分配。地址示例：D100（DM）· W100（WR）· H100（HR）· CIO100 / CIO100.05。自实现协议，首用建议现场联机验证。"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </mahs:MetroWindow.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== 顶部标题 ===================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="4" CornerRadius="2" Background="{DynamicResource Token.Primary}" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="通讯驱动管理" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Token.Text.Primary}"/>
                <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,2,0,0"
                           Text="统一配置 TCP / UDP / 串口 / Modbus / MQTT / WebSocket / 西门子S7 / 三菱MC / 欧姆龙FINS 驱动；通讯算子只需在下拉框选择驱动名称，长连接复用。"/>
            </StackPanel>
        </StackPanel>

        <!-- ===================== 主体：列表 + 编辑器 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：驱动列表 -->
            <Border Style="{StaticResource Plugin.Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="NewDriverType" Width="168" SelectedIndex="0" Style="{StaticResource Plugin.ComboBox}"
                                  ToolTip="选择要新建的驱动类型">
                            <ComboBoxItem Content="TCP 客户端"/>
                            <ComboBoxItem Content="TCP 服务端"/>
                            <ComboBoxItem Content="UDP"/>
                            <ComboBoxItem Content="串口"/>
                            <ComboBoxItem Content="Modbus TCP"/>
                            <ComboBoxItem Content="Modbus RTU"/>
                            <ComboBoxItem Content="MQTT"/>
                            <ComboBoxItem Content="WebSocket"/>
                            <ComboBoxItem Content="西门子S7"/>
                            <ComboBoxItem Content="三菱MC"/>
                            <ComboBoxItem Content="欧姆龙FINS"/>
                            <ComboBoxItem Content="回环(调试)"/>
                        </ComboBox>
                        <Button Content="新增" Click="OnAddDriver" Style="{StaticResource Plugin.Button.Primary}"
                                Padding="12,5" Margin="8,0,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="DriverList" HorizontalContentAlignment="Stretch"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnDriverSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Plugin.ListItem}" Margin="0,0,4,4" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource Token.Primary}"
                                                     Opacity="0.85" CornerRadius="4" Padding="5,2"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                                     HorizontalAlignment="Left">
                                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White" Text="{Binding TypeIcon}"/>
                                                    </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Token.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Token.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Token.Text.Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Fill" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontSize="9.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Token.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatsText}" FontSize="9.5" Margin="8,0,0,0" Opacity="0.75"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Token.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="OnDeleteDriver" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Token.Status.Danger}"
                                                Cursor="Hand" VerticalAlignment="Top" Margin="4,0,0,0"
                                                ToolTip="删除该驱动配置">
                                            <Path Width="11" Height="11" Data="{StaticResource Icon.Close}"
                                                  Stroke="{DynamicResource Token.Status.Danger}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" x:Name="ListHint" Style="{StaticResource Plugin.Hint}" Margin="2,6,0,0"
                               Text="左侧选择驱动 → 右侧编辑参数 → 保存配置后生效"/>
                </Grid>
            </Border>

            <!-- 右：编辑器 -->
            <Border Grid.Column="2" Style="{StaticResource Plugin.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具行：连接控制 + 实时状态 -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ToggleConnectButton" Content="连接" Click="OnToggleConnect"
                                Style="{StaticResource Plugin.Button.Primary}" Padding="12,6" MinWidth="88"/>
                        <Ellipse x:Name="ConnDot" Width="8" Height="8" VerticalAlignment="Center" Margin="14,0,6,0" Fill="Gray"/>
                        <TextBlock x:Name="ConnectStatus" VerticalAlignment="Center" FontSize="11" MinWidth="60"
                                   Foreground="{DynamicResource Token.Text.Secondary}" Text=""/>
                        <Button Content="清空接收缓冲" Click="OnClearBuffer" Style="{StaticResource Plugin.Button.Secondary}"
                                Padding="10,5" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 参数区：统一滚动 -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,0,6,0">

                            <!-- 分区一：基本信息 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Token.Primary}"/>
                                <TextBlock Text="基本信息" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Token.Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="驱动名称（通讯算子下拉中显示此项，必填唯一）" Style="{StaticResource Plugin.Label}"/>
                            <TextBox x:Name="DriverNameBox" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,8"/>
                            <TextBlock Text="备注说明" Style="{StaticResource Plugin.Label}"/>
                            <TextBox x:Name="DriverDescBox" Style="{StaticResource Plugin.TextBox}" Margin="0,3,0,14"/>

                            <!-- 分区二：类型专属参数（模板自带标题） -->
                            <ContentControl x:Name="ConfigEditor"/>

                            <!-- 分区三：联动与自启 -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Token.Primary}"/>
                                <TextBlock Text="联动与自启" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Token.Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectCheck" Content="启动时自动连接"
                                      ToolTip="应用启动后自动建立该驱动连接"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="TriggerCheck" Content="接收触发流程" VerticalAlignment="Center"
                                          ToolTip="该驱动收到数据时自动执行指定流程（PLC 给信号→检测→回写）"/>
                                <TextBox x:Name="TriggerWorkflowBox" Width="130" Margin="8,0,0,0"
                                         Style="{StaticResource Plugin.TextBox}" FontSize="11" VerticalAlignment="Center"
                                         ToolTip="触发执行的流程名；留空=当前活动流程"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,10,0,0"
                                       Text="「接收触发流程」适用于被动收数据的驱动（TCP/串口/MQTT 等）；PLC 驱动请用「PLC读取」算子轮询信号。"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="导入配置" Click="OnImportConfigs" Style="{StaticResource Plugin.Button.Secondary}" Padding="10,6"
                                ToolTip="从 JSON 文件导入驱动配置（同名跳过）"/>
                        <Button Content="导出全部" Click="OnExportConfigs" Style="{StaticResource Plugin.Button.Secondary}" Padding="10,6" Margin="8,0,0,0"
                                ToolTip="导出全部驱动配置到 JSON 文件（工位迁移）"/>
                        <Button Content="保存配置" Click="OnSaveConfig" Style="{StaticResource Plugin.Button.Primary}" Padding="16,7" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 报文监视器（可折叠） ===================== -->
        <Expander Grid.Row="2" Margin="0,12,0,0" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="报文监视器" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Token.Primary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MonitorDriverName" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Token.Text.Muted}" Text="（选择左侧驱动后显示）"/>
                    <TextBlock FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                               Foreground="{DynamicResource Token.Text.Muted}" Text="展开查看实时收发帧"/>
                </StackPanel>
            </Expander.Header>
            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource Token.Surface.Card}"
                    BorderBrush="{DynamicResource Token.Border.Subtle}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <CheckBox x:Name="HexViewCheck" Content="HEX 显示" IsChecked="True" Margin="12,0,0,0"
                                  FontSize="10.5" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="暂停" Click="OnTogglePauseMonitor" Style="{StaticResource Plugin.Button.Secondary}"
                                    Padding="8,3" FontSize="10.5"/>
                            <Button Content="清空" Click="OnClearMonitor" Style="{StaticResource Plugin.Button.Secondary}"
                                    Padding="8,3" Margin="6,0,0,0" FontSize="10.5"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="MonitorList" Margin="0,6,0,0" MaxHeight="200"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="10.5"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Expander>

        <!-- ===================== 状态栏 ===================== -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource Token.Surface.Muted}">
            <TextBlock x:Name="StatusBar" FontSize="11" Foreground="{DynamicResource Token.Text.Secondary}"
                       Text="就绪。通讯算子参数中的「通讯驱动」下拉框会列出这里配置的驱动。"/>
        </Border>
    </Grid>
</mahs:MetroWindow>
