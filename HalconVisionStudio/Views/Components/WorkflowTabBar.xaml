<UserControl
    x:Class="HalconVisionStudio.Views.Components.WorkflowTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程区域标识徽章 -->
        <Border
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="9,5"
            VerticalAlignment="Center"
            Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
            BorderBrush="{DynamicResource Theme.Vision.Border}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path
                    Width="14"
                    Height="14"
                    Data="{StaticResource Icon.Workflow}"
                    Stroke="{DynamicResource MahApps.Brushes.Accent}"
                    Style="{StaticResource ToolbarIconPathStyle}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                    Text="流程" />
            </StackPanel>
        </Border>

        <!-- 中间：流程标签分段底轨与就近管理按钮 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- 标签列表容器（卡片底轨样式） -->
            <Border
                Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ItemsSource="{Binding Workflows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding ActiveWorkflow, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="TabBorder"
                                            MinWidth="80"
                                            Height="28"
                                            Padding="10,0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Ellipse
                                                    x:Name="TabIndicator"
                                                    Width="6"
                                                    Height="6"
                                                    Margin="0,0,6,0"
                                                    Fill="{DynamicResource Theme.Vision.Text.Muted}" />
                                                <TextBlock
                                                    x:Name="TabText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Normal"
                                                    Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                                                    Text="{Binding WorkflowName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Vision.Panel.Background}" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
                                                <Setter TargetName="TabIndicator" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 流程增减快捷操作组（紧邻标签栏，消除远距离割裂） -->
            <Border
                Margin="6,0,0,0"
                Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding AddWorkflowCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="新建流程 (添加工作流标签)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource Icon.Add}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Separator Width="1" Height="14" Margin="1,0" Background="{DynamicResource Theme.Vision.Border}" />
                    <Button
                        Command="{Binding RemoveWorkflowCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="删除当前流程">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource Icon.Remove}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 右侧：执行调试与历史操作控制区 -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- 执行调试功能群 -->
            <!-- 1. 执行节点（单步调试次级操作） -->
            <Button
                Command="{Binding HandleExecCommand}"
                Height="32"
                Margin="0,0,6,0"
                Background="{DynamicResource Theme.Vision.Status.Running.Background}"
                BorderBrush="{DynamicResource Theme.Vision.Status.Running.Border}"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="仅执行当前选中的单个节点 (单步调试)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                <Path
                                    Width="13"
                                    Height="13"
                                    Data="{StaticResource Icon.Execute}"
                                    Stroke="{DynamicResource Theme.Vision.Status.Running}"
                                    Style="{StaticResource ToolbarIconPathStyle}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Vision.Status.Running}"
                                    Text="执行节点" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 2. 运行流程（核心主操作，绿色胶囊高亮带投影） -->
            <Button
                Command="{Binding StartProcessCommand}"
                Height="32"
                MinWidth="96"
                Margin="0,0,6,0"
                Background="#10B981"
                BorderBrush="#059669"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="从头运行当前流程完整链路 (F5)">
                <Button.Effect>
                    <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="1.5" Opacity="0.25" Direction="270" />
                </Button.Effect>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                                <Path Width="11" Height="13" Data="{StaticResource Icon.Run}" Fill="White" Stretch="Uniform" />
                                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Text="运行流程" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#059669" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 3. 连续运行（状态感知切换按钮，运行中点亮） -->
            <Button
                Command="{Binding ToggleContinuousRunCommand}"
                Height="32"
                Margin="0,0,6,0"
                Cursor="Hand"
                ToolTip="循环执行当前流程（再次点击停止）">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Panel.Background}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Margin="9,0" VerticalAlignment="Center">
                                            <Path
                                                Width="13"
                                                Height="13"
                                                Data="{StaticResource Icon.Loop}"
                                                Stroke="{TemplateBinding Foreground}"
                                                Style="{StaticResource ToolbarIconPathStyle}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{Binding ContinuousRunButtonText}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContinuousRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Warning.Background}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 4. 停止（警示红色，执行时高亮） -->
            <Button
                Command="{Binding StopExecutionCommand}"
                Height="32"
                Margin="0,0,8,0"
                Cursor="Hand"
                ToolTip="立即停止正在执行的流程 (Esc)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource Theme.Vision.Panel.Background}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Status.Failed}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Margin="9,0" VerticalAlignment="Center">
                                            <Path
                                                Width="11"
                                                Height="11"
                                                Data="{StaticResource Icon.Stop}"
                                                Fill="{TemplateBinding Foreground}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="停止" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Vision.Status.Failed.Background}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Failed.Border}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Failed.Background}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Failed}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 分组分隔线 -->
            <Separator Width="1" Height="18" Margin="2,0,10,0" Background="{DynamicResource Theme.Vision.Border}" />

            <!-- 历史操作区（撤销 / 重做 紧凑胶囊组） -->
            <Border
                Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding UndoCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="撤销 (Ctrl+Z)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="{StaticResource Icon.Undo}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Separator Width="1" Height="14" Margin="1,0" Background="{DynamicResource Theme.Vision.Border}" />
                    <Button
                        Command="{Binding RedoCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="重做 (Ctrl+Y)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="{StaticResource Icon.Redo}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
