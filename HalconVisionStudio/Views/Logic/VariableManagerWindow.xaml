<mahs:MetroWindow
    x:Class="HalconVisionStudio.Views.Logic.VariableManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    Title="全局变量"
    Width="620"
    Height="520"
    MinWidth="520"
    MinHeight="380"
    WindowStartupLocation="CenterOwner"
    FontFamily="Microsoft YaHei UI"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <mahs:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mahs:MetroWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="4" CornerRadius="2" Background="{DynamicResource Token.Primary}" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="全局流程变量" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Token.Text.Primary}"/>
                <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,2,0,0"
                           Text="「变量写入/读取」算子与流程执行共用的全局变量；实时刷新，可在运行中直接观察与修改。程序重启后清空。"/>
            </StackPanel>
        </StackPanel>

        <!-- 新增/编辑行 -->
        <Border Grid.Row="1" Style="{StaticResource Plugin.Card}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Style="{StaticResource Plugin.TextBox}" mahs:TextBoxHelper.Watermark="变量名"/>
                <TextBox Grid.Column="2" x:Name="ValueBox" Style="{StaticResource Plugin.TextBox}" mahs:TextBoxHelper.Watermark="值（true/false、数字或文本）"/>
                <ComboBox Grid.Column="3" x:Name="ScopeBox" Width="110" Style="{StaticResource Plugin.ComboBox}" SelectedIndex="0" Margin="8,0,0,0"
                          ToolTip="全局：所有流程可读；流程级：仅当前流程可读">
                    <ComboBoxItem Content="全局"/>
                    <ComboBoxItem Content="流程级"/>
                </ComboBox>
                <Button Grid.Column="4" Content="写入" Click="OnWriteVariable" Style="{StaticResource Plugin.Button.Primary}"
                        Padding="14,6" Margin="8,0,0,0" ToolTip="写入/更新该变量（同作用域同名覆盖）"/>
            </Grid>
        </Border>

        <!-- 变量列表 -->
        <Border Grid.Row="2" Style="{StaticResource Plugin.Card}" Padding="4">
            <DataGrid x:Name="VarGrid"
                      Background="Transparent"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="变量名" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="编辑" Click="OnEditVariable" Tag="{Binding}"
                                            Style="{StaticResource Plugin.Button.Secondary}" Padding="8,3" FontSize="11" Margin="2"/>
                                    <Button Content="删除" Click="OnDeleteVariable" Tag="{Binding}"
                                            Style="{StaticResource Plugin.Button.Secondary}" Padding="8,3" FontSize="11" Margin="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部操作 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Token.Text.Secondary}" Text="就绪"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="AutoRefreshCheck" Content="实时刷新（0.5s）" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="清空全部" Click="OnClearAll" Style="{StaticResource Plugin.Button.Secondary}" Padding="10,6"
                        ToolTip="删除所有全局变量"/>
            </StackPanel>
        </Grid>
    </Grid>
</mahs:MetroWindow>
