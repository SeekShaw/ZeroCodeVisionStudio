<mahs:MetroWindow
    x:Class="HalconVisionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HalconVisionStudio.UI.Controls;assembly=HalconVisionStudio.UI"
    xmlns:components="clr-namespace:HalconVisionStudio.Views.Components"
    xmlns:views="clr-namespace:HalconVisionStudio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HalconVisionStudio"
    xmlns:mahs="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding SchemeTitle}"
    Width="1400"
    Height="820"
    MinWidth="1024"
    MinHeight="700"
    d:DataContext="{d:DesignInstance Type={x:Type local:MainViewModel}}"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
    mc:Ignorable="d">
    <mahs:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="VerticalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{DynamicResource MahApps.Brushes.Gray5}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Height="1"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource MahApps.Brushes.Gray5}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mahs:MetroWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <components:MainMenuBar Grid.Row="0" />

                <components:WorkflowTabBar Grid.Row="1" Margin="10,5" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto"
                    MinWidth="70"
                    MaxWidth="350" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,6,0"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:ToolboxPanel AddNodeCommand="{Binding AddNodeCommand}" ItemsSource="{Binding HandleControl.HandleView}" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <controls:WorkflowEditor
                    AddNodeCommand="{Binding AddNodeCommand}"
                    AutoLayoutCommand="{Binding AutoLayoutCommand}"
                    ConnectNodesCommand="{Binding AddConnectionCommand}"
                    Connections="{Binding Connections}"
                    DeleteConnectionCommand="{Binding DeleteConnectionCommand}"
                    DeleteSelectedConnectionCommand="{Binding DeleteSelectedConnectionCommand}"
                    MoveNodeCommand="{Binding MoveNodeCommand}"
                    NodeDeleteCommand="{Binding DeleteNodeCommand}"
                    NodeEditCommand="{Binding HandleEditCommand}"
                    NodeExecuteCommand="{Binding HandleExecCommand}"
  NodeConditionCommand="{Binding SetNodeConditionCommand}"
                    Nodes="{Binding Nodes}"
                    SelectConnectionCommand="{Binding SelectConnectionCommand}"
                    RedoCommand="{Binding RedoCommand}"
                    SelectNodeCommand="{Binding SelectNodeCommand}"
                    SetInputBindingCommand="{Binding SetInputBindingCommand}"
                    StopExecutionCommand="{Binding StopExecutionCommand}"
                    UndoCommand="{Binding UndoCommand}"
                    WorkflowScale="{Binding WorkflowScale}" />
            </Border>

            <GridSplitter
                Grid.Column="2"
                Style="{StaticResource VerticalPaneSplitterStyle}" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.1*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  显示面板  -->
                <Border
                    Grid.Row="0"
                    Margin="4,0,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  标题行：显示 + 添加显示源  -->
                        <Grid Margin="12,10,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="显示" />
                                <TextBlock
                                    Margin="10,2,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="当前算子执行结果" />
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    MinWidth="0"
                                    MinHeight="26"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding AllWorkflowDisplayOutputs}"
                                    SelectedItem="{Binding SelectedDisplayOutput, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddDisplaySourceCommand}"
                                    CommandParameter="{Binding SelectedDisplayOutput}"
                                    Style="{StaticResource SchemeButtonStyle}"
                                    ToolTip="添加显示源">
                                    <Grid Width="16" Height="16">
                                        <Path
                                            Data="M8,3 V13 M3,8 H13"
                                            Stroke="{DynamicResource MahApps.Brushes.Text}"
                                            Style="{StaticResource ToolbarIconPathStyle}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>

                        <!--  HALCON 显示窗口  -->
                        <Border
                            Grid.Row="1"
                            Margin="10,0,10,0"
                            Background="{DynamicResource Theme.Vision.Viewport.Background}"
                            CornerRadius="4">
                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding HWindow}" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            MaxWidth="320"
                            Margin="20,12"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{Binding DisplayOverlayBackground}"
                            CornerRadius="6"
                            Visibility="{Binding HasDisplayOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{Binding DisplayOverlayForeground}"
                                Text="{Binding DisplayOverlayText}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  显示源列表  -->
                        <Border
                            Grid.Row="2"
                            MinHeight="110"
                            MaxHeight="150"
                            Margin="10,8,10,10"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,8,0,6">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MahApps.Brushes.Text}"
                                        Text="显示源" />
                                    <TextBlock
                                        Margin="8,1,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                        Text="可见性 / 顺序"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ListBox
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding DisplaySources}"
                                    SelectedItem="{Binding SelectedDisplaySource, Mode=TwoWay}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="2,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="6,0,6,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0,0,3,0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.MoveDisplaySourceUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="上移">
                                                            <Path
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M3,8 L6,4 L9,8"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource MahApps.Brushes.Text}"
                                                                StrokeLineJoin="Round"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0,0,3,0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.MoveDisplaySourceDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="下移">
                                                            <Path
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M3,4 L6,8 L9,4"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource MahApps.Brushes.Text}"
                                                                StrokeLineJoin="Round"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.RemoveDisplaySourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="删除">
                                                            <Path
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M4,4 L12,12 M12,4 L4,12"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource Theme.Vision.Status.Failed}"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter
                    Grid.Row="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource HorizontalPaneSplitterStyle}" />

                <!--  底部：TabControl - 模块结果 / 输入绑定  -->
                <Border
                    Grid.Row="2"
                    Margin="4,0,0,0"
                    Style="{StaticResource PanelBorderStyle}">

                    <mahs:MetroTabControl
                        Margin="10,6,10,10"
                        mahs:TabControlHelper.Underlined="TabPanel"
                        Background="Transparent"
                        BorderThickness="0"
                        Style="{DynamicResource MahApps.Styles.TabControl.Animated}">
                        <mahs:MetroTabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </mahs:MetroTabControl.ItemTemplate>

                        <!--  Tab 1：模块结果  -->
                        <TabItem Header="模块结果">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    Margin="2,4,0,4"
                                    MaxHeight="58"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                        Text="{Binding ResultMessage}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                                <DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    GridLinesVisibility="Horizontal"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ExecutionRecords}"
                                    SelectedItem="{Binding SelectedExecutionRecord, Mode=TwoWay}"
                                    controls:DataGridAutoScrollHelper.AutoScrollToBottom="True"
                                    controls:DataGridAutoScrollHelper.ScrollToSelectedItem="True"
                                    RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="54"
                                            Binding="{Binding Sequence}"
                                            Header="序号" />
                                        <DataGridTextColumn
                                            Width="88"
                                            Binding="{Binding ExecuteTime, StringFormat=HH:mm:ss}"
                                            Header="执行时间" />
                                        <DataGridTextColumn
                                            Width="110"
                                            Binding="{Binding Module}"
                                            Header="模块" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding StatusText}"
                                            Header="状态" />
                                        <DataGridTextColumn
                                            Width="82"
                                            Binding="{Binding ElapsedText}"
                                            Header="耗时" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding ResultData}"
                                            Header="结果数据" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!--  Tab 2：输入绑定（绑定值优先于算子参数中的手动值）  -->
                        <TabItem Header="输入绑定">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="2,4,0,6"
                                    FontSize="11"
                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                    Text="已设置绑定的参数在执行时优先使用上游节点的输出值。"
                                    TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedInputBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Margin="0,0,0,4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                            Text="{Binding InputName}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Description}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="52" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                MinHeight="26"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding Options}"
                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding ClearCommand}"
                                                                Content="清除" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </mahs:MetroTabControl>
                </Border>
            </Grid>
        </Grid>

        
        <!-- AI 助手抽屉 (Copilot & MCP) -->
        <Border
            Grid.RowSpan="2"
            Width="420"
            HorizontalAlignment="Right"
            Panel.ZIndex="35"
            Background="{DynamicResource Token.Surface.Card}"
            BorderBrush="{DynamicResource Token.Border.Subtle}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding IsCopilotOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:VisionCopilotPanel DataContext="{Binding Copilot}" />
        </Border>

        
        <Border
            Grid.RowSpan="2"
            Background="{DynamicResource Theme.Vision.Overlay.Background}"
            Panel.ZIndex="50"
            Visibility="{Binding IsSchemeLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="StackPanel.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="SchemeLoadingRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0"
                                        To="360"
                                        Duration="0:0:1.1" />
                                    <DoubleAnimation
                                        AutoReverse="True"
                                        Storyboard.TargetName="SchemeLoadingPulse"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.35"
                                        To="0.9"
                                        Duration="0:0:0.65" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Grid Width="78" Height="78">
                        <Ellipse
                            Stroke="{DynamicResource MahApps.Brushes.Text}"
                            StrokeThickness="8" />
                        <Ellipse
                            Stroke="{DynamicResource Theme.Vision.Status.Running}"
                            StrokeDashArray="0.42,1.35"
                            StrokeDashCap="Round"
                            StrokeThickness="8">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SchemeLoadingRotate" CenterX="39" CenterY="39" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="SchemeLoadingPulse"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Theme.Vision.Status.Success}" />
                    </Grid>
                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding SchemeLoadingMessage}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Vision.Text.Muted}"
                        Text="请稍候，正在重建流程画布和节点绑定" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mahs:MetroWindow>



