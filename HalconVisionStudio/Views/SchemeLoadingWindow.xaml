<Window
    x:Class="HalconVisionStudio.Views.SchemeLoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="210"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Grid>
        <Border
            Padding="26,24"
            Background="{DynamicResource Theme.Vision.Panel.Background}"
            BorderBrush="{DynamicResource Theme.Vision.Border}"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.24"
                    ShadowDepth="4"
                    Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Width="70"
                    Height="70"
                    HorizontalAlignment="Center">
                    <Ellipse
                        Stroke="{DynamicResource Theme.Vision.Border}"
                        StrokeThickness="8" />
                    <Ellipse
                        Stroke="{DynamicResource Theme.Vision.Status.Running}"
                        StrokeDashArray="0.42,1.35"
                        StrokeDashCap="Round"
                        StrokeThickness="8">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRotate" CenterX="35" CenterY="35" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse
                        x:Name="LoadingPulse"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource Theme.Vision.Status.Success}" />
                </Grid>

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                    Text="正在加载方案..."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                    Text="正在恢复流程节点和画布，请稍候"
                    TextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
