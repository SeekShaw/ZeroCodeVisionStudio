<mahs:MetroWindow
    x:Class="HalconVisionStudio.Views.SystemSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    Title="系统设置"
    Width="560"
    Height="640"
    MinWidth="480"
    MinHeight="460"
    WindowStartupLocation="CenterOwner"
    FontFamily="Microsoft YaHei UI"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <mahs:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mahs:MetroWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="4" CornerRadius="2" Background="{DynamicResource Token.Primary}" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="系统设置" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Token.Text.Primary}"/>
                <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,2,0,0"
                           Text="执行策略与界面主题。执行设置中的并行开关作用于当前流程，随方案保存。"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ========== 执行设置 ========== -->
                <TextBlock Text="执行设置" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.Text.Primary}" Margin="2,2,0,8"/>
                <Border Style="{StaticResource Plugin.Card}" Padding="12">
                    <StackPanel>
                        <CheckBox
                            Content="并行执行（当前流程）"
                            FontSize="12"
                            IsChecked="{Binding ActiveWorkflow.ParallelExecution, Mode=TwoWay}"
                            ToolTip="同一层的兄弟分支并发执行、层间按拓扑顺序等待；节点就绪即执行（数据流调度）。适合多条独立检测分支提速。"/>
                        <TextBlock Style="{StaticResource Plugin.Hint}" Margin="24,4,0,10"
                                   Text="注意：同层分支写同一驱动/变量时先后顺序不确定（执行前有风险告警）。"/>

                        <TextBlock Text="节点执行超时（秒，5-3600）" Style="{StaticResource Plugin.Label}" Margin="0,0,0,6"/>
                        <TextBox
                            Height="32"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Plugin.TextBox}"
                            Text="{Binding NodeExecutionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            ToolTip="单个节点执行超过该时长视为失败并中止整个流程"/>
                        <TextBlock Style="{StaticResource Plugin.Hint}" Margin="0,6,0,0"
                                   Text="对通讯等待、相机采集等可能阻塞的算子生效；超时后停止整个流程并在执行日志留档。"/>
                    </StackPanel>
                </Border>

                <!-- ========== 主题 ========== -->
                <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.Text.Primary}" Margin="2,20,0,8"/>
                <Border Style="{StaticResource Plugin.Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="模式" Style="{StaticResource Plugin.Label}" Margin="0,0,0,6"/>
                        <ComboBox
                            Height="32"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Plugin.ComboBox}"
                            ItemsSource="{Binding ThemeModes}"
                            SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"/>

                        <TextBlock Text="主题色" Style="{StaticResource Plugin.Label}" Margin="0,14,0,6"/>
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding ThemeAccents}"
                            SelectedItem="{Binding SelectedThemeAccent, Mode=TwoWay}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,8"
                                        Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" Margin="0,0,10,0"
                                                    Background="{Binding PreviewBrush}" CornerRadius="3"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Token.Text.Primary}"
                                                       Text="{Binding DisplayName}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="88" Height="34" Click="OnClose"
                    Style="{StaticResource Plugin.Button.Secondary}"/>
        </StackPanel>
    </Grid>
</mahs:MetroWindow>
