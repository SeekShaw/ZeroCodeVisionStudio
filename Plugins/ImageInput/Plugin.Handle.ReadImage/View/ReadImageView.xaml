<UserControl
    x:Class="Plugin.Handle.ReadImage.View.ReadImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:HalconVisionStudio.Shared;assembly=HalconVisionStudio.Shared"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Plugin.Handle.ReadImage.ViewModel"
    xmlns:readImage="clr-namespace:Plugin.Handle.ReadImage"
    xmlns:model="clr-namespace:Plugin.Handle.ReadImage.Model"
    d:DataContext="{d:DesignInstance Type={x:Type vm:ReadImageViewModel}}"
    d:DesignHeight="560"
    d:DesignWidth="980"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 共享插件样式：按钮/输入框/文本卡片，主题感知（DynamicResource Token.*） -->
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 语义色别名：主体引用 Token.*（DynamicResource），跟随明暗主题 -->
            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Primary}"/>
            <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Secondary}"/>
            <Style x:Key="BtnDangerGhost" TargetType="Button" BasedOn="{StaticResource Plugin.Button.DangerGhost}"/>

            <Style x:Key="RowDeleteBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Token.Text.Muted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Token.Surface.Muted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ImageFileListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Token.Surface.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="420" MinWidth="360" MaxWidth="560" />
        </Grid.ColumnDefinitions>

        <!-- 1. 左侧：高保真图像预览区域 -->
        <Border Grid.Column="0" Background="{DynamicResource Token.Text.Primary}" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding DispalyImage}" Stretch="Uniform" Margin="10" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DispalyImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DispalyImage}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Width="46" Height="46" Data="{StaticResource Icon.Image}" Style="{StaticResource ToolbarIconPathStyle}" Opacity="0.55" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="暂无预览图像" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Token.Text.Muted}"/>
                    <TextBlock Text="请在右侧添加或选择图像文件" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Token.Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12" 
                        Background="#CC0F172A" CornerRadius="6" Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedItem.FileName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Token.Surface.Card}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="  |  " Foreground="{DynamicResource Token.Text.Secondary}" Margin="2,0"/>
                            <TextBlock Text="{Binding SelectedItem.Dimensions, StringFormat='尺寸: {0}'}" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock Text="  |  " Foreground="{DynamicResource Token.Text.Secondary}" Margin="2,0"/>
                            <TextBlock Text="{Binding SelectedItem.FileSizeText, StringFormat='大小: {0}'}" FontSize="11" Foreground="#A7F3D0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#334155" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedItem.Extension}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Token.Surface.Muted}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Token.Border.Subtle}" ShowsPreview="True"/>

        <!-- 2. 右侧：文件列表、多维信息与交互控制 -->
        <Grid Grid.Column="2" Background="{DynamicResource Token.Surface.Card}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A. 顶部标题栏与快速操作 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Token.Border.Subtle}" BorderThickness="0,0,0,1" Padding="14,10" Background="{DynamicResource Token.Surface.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <TextBlock Text="图像文件清单" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Token.Text.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusSummaryText}" FontSize="11" Foreground="{DynamicResource Token.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加文件" Command="{Binding AddFilesCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0"/>
                        <Button Content="添加目录" Command="{Binding AddFolderCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"/>
                        <Button Content="名称排序" Command="{Binding SortByNameCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"/>
                        <Button Content="清空全部" Command="{Binding ClearAllCommand}" Style="{StaticResource BtnDangerGhost}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- B. 图像文件卡片列表 -->
                        <TabControl Grid.Row="1" Background="Transparent" Style="{StaticResource Plugin.TabControl}">
                <TabItem Header="参数设置">
                                    <Grid>
                                <ListBox x:Name="FileListBox" 
                                         ItemsSource="{Binding Items}" 
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         Style="{StaticResource ImageFileListBoxStyle}"
                                         Margin="8,6"
                                         AllowDrop="True"
                                         PreviewDragOver="FileListBox_PreviewDragOver"
                                         Drop="FileListBox_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type model:ImageFileItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" 
                                                        Background="{DynamicResource Token.Border.Subtle}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Token.Text.Secondary}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource Token.Text.Primary}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>

                                                        <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Background="#E0E7FF" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Extension}" FontSize="9.5" FontWeight="Bold" Foreground="#4338CA"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Dimensions}" FontSize="10.5" Foreground="{DynamicResource Token.Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource Token.Text.Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FileSizeText}" FontSize="10.5" Foreground="{DynamicResource Token.Text.Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource Token.Text.Muted}" 
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" 
                                                        Content="×" 
                                                        ToolTip="从列表中移除此图像" 
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RowDeleteBtn}"
                                                        Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="在资源管理器中显示" Command="{Binding OpenInExplorerCommand}"/>
                                            <MenuItem Header="复制文件完整路径" Command="{Binding CopyPathCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="向上移动" Command="{Binding MoveUpCommand}"/>
                                            <MenuItem Header="向下移动" Command="{Binding MoveDownCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="移除选中图像" Command="{Binding RemoveSelectedCommand}"/>
                                            <MenuItem Header="清空所有文件" Command="{Binding ClearAllCommand}"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>

                                <Border Background="{DynamicResource Token.Surface.Background}" BorderBrush="{DynamicResource Token.Text.Muted}" BorderThickness="1.5" CornerRadius="8" Margin="16" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Width="34" Height="34" Data="{StaticResource Icon.Image}" Style="{StaticResource ToolbarIconPathStyle}" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="暂无图像文件" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Token.Text.Secondary}"/>
                                        <TextBlock Text="点击上方'添加文件'或直接将图像/文件夹拖拽至此处" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Token.Text.Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                </TabItem>
                <TabItem Header="输入与参数绑定">
                    <shared:ParameterBindingSection />
                </TabItem>
            </TabControl>

            <!-- C. 底部运行模式设置与顺序调整 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Token.Border.Subtle}" BorderThickness="0,1,0,0" Padding="12,10" Background="{DynamicResource Token.Surface.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="读取模式:" FontSize="12" Foreground="{DynamicResource Token.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding ReadMode}" Height="28">
                            <readImage:ImageReadMode>Cycle</readImage:ImageReadMode>
                            <readImage:ImageReadMode>Single</readImage:ImageReadMode>
                            <readImage:ImageReadMode>Random</readImage:ImageReadMode>
                        </ComboBox>
                    </Grid>

                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="上移" Command="{Binding MoveUpCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,4,0"/>
                        <Button DockPanel.Dock="Left" Content="下移" Command="{Binding MoveDownCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Left" Content="移除选中" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="从首张开始" Command="{Binding ResetIndexCommand}" Style="{StaticResource BtnSecondary}"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
