<UserControl
    x:Class="Plugin.Handle.DistanceMeasure.Views.DistancePLView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:HalconVisionStudio.Shared;assembly=HalconVisionStudio.Shared"
    xmlns:vm="clr-namespace:Plugin.Handle.DistanceMeasure.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:DistancePLViewModel}}"
    d:DesignHeight="600"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 共享插件样式：按钮/输入框/文本/卡片，主题感知（DynamicResource Token.*） -->
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Token.Surface.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="320" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：图像与测量图元实时视窗 -->
        <Border Grid.Column="0" Style="{StaticResource Plugin.PreviewHost}">
            <ContentControl Content="{Binding HWindow}" />
        </Border>

        <!-- 右侧：参数设置与结果面板 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                        <TabControl Grid.Row="0" Background="Transparent" Style="{StaticResource Plugin.TabControl}">
                <TabItem Header="参数设置">
                    <ScrollViewer
                Padding="16,14,14,10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Plugin.SectionTitle}" Text="点到线距离测量 (Distance PL)" />

                    <!-- 交互绘制卡片 -->
                    <Border Margin="0,0,0,10" Style="{StaticResource Plugin.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Border Style="{StaticResource Plugin.Section}" />
                                <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="交互绘制" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Height="30"
                                    Command="{Binding DrawPointCommand}"
                                    Content="采集目标测点"
                                    Style="{StaticResource Plugin.Button.Primary}" />
                                <Button
                                    Grid.Column="2"
                                    Height="30"
                                    Command="{Binding DrawLineCommand}"
                                    Content="绘制基准直线"
                                    Style="{StaticResource Plugin.Button.Secondary}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Plugin.Hint}" Text="{Binding DrawHint}" />
                        </StackPanel>
                    </Border>

                    <!-- 测点与基准线坐标 -->
                    <Border Margin="0,0,0,10" Style="{StaticResource Plugin.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Border Style="{StaticResource Plugin.Section}" />
                                <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="几何要素坐标 (像素)" />
                            </StackPanel>
                            <!-- 测点 -->
                            <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Token.Text.Primary}" Text="目标测点 (Row / Col)" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.PointRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.PointCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!-- 基准线 -->
                            <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Token.Text.Primary}" Text="基准线起点 (Row1 / Col1)" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.LineRow1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.LineCol1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Token.Text.Primary}" Text="基准线终点 (Row2 / Col2)" />
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.LineRow2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.LineCol2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 标定与单位 -->
                    <Border Margin="0,0,0,10" Style="{StaticResource Plugin.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Border Style="{StaticResource Plugin.Section}" />
                                <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="单位换算与标定" />
                            </StackPanel>
                            <Grid Style="{DynamicResource ParameterRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Plugin.Label}" Text="像素当量" />
                                <TextBox Grid.Column="1" Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.CalibScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{DynamicResource ParameterRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Plugin.Label}" Text="显示单位" />
                                <TextBox Grid.Column="1" Style="{StaticResource Plugin.TextBox}" Text="{Binding Parameter.UnitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 测量结果看板 -->
                    <Border Margin="0,0,0,6" Style="{StaticResource Plugin.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <Border Style="{StaticResource Plugin.Section}" />
                                <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="实测结果" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Token.Primary}"
                                Text="{Binding MeasureResultText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </TabItem>
                <TabItem Header="输入与参数绑定">
                    <shared:ParameterBindingSection />
                </TabItem>
            </TabControl>

            <!-- 底部操作栏 -->
            <Border Grid.Row="1" Style="{DynamicResource ActionBarStyle}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding ClearDrawCommand}" Content="清除绘制" Style="{StaticResource Plugin.Button.Secondary}" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ResetCommand}"
                        Content="恢复默认"
                        Style="{StaticResource Plugin.Button.Secondary}" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ExecuteCommand}"
                        Content="执行预览"
                        Style="{StaticResource Plugin.Button.Primary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
