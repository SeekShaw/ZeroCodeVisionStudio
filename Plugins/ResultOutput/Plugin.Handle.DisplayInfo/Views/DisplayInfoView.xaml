<UserControl
    x:Class="Plugin.Handle.DisplayInfo.Views.DisplayInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:HalconVisionStudio.Shared;assembly=HalconVisionStudio.Shared"
    xmlns:viewModels="clr-namespace:Plugin.Handle.DisplayInfo.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:DisplayInfoViewModel}}"
    d:DesignHeight="560"
    d:DesignWidth="620"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 共享插件样式：按钮/输入框/文本卡片，主题感知（DynamicResource Token.*） -->
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <TabControl Background="Transparent" Style="{StaticResource Plugin.TabControl}">
            <TabItem Header="参数设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Style="{StaticResource Plugin.Section}" />
                    <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="基本信息" />
                </StackPanel>
                <Border Style="{StaticResource Plugin.Card}" Margin="0,0,0,6">
                    <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="标题文本" />
                        <TextBox
                            Style="{StaticResource Plugin.TextBox}"
                            Grid.Column="1"
                            MinHeight="28"
                            Text="{Binding Parameter.HeaderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="附加文本" />
                        <TextBox
                            Style="{StaticResource Plugin.TextBox}"
                            Grid.Column="1"
                            MinHeight="72"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Text="{Binding Parameter.FreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="文字颜色" />
                        <TextBox
                            Style="{StaticResource Plugin.TextBox}"
                            Grid.Column="1"
                            MinHeight="28"
                            Margin="0,0,12,0"
                            Text="{Binding Parameter.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="背景颜色" />
                        <TextBox
                            Style="{StaticResource Plugin.TextBox}"
                            Grid.Column="3"
                            MinHeight="28"
                            Text="{Binding Parameter.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    </StackPanel>
                </Border>
                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Plugin.Section}" />
                        <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="动态显示项" />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Width="92"
                        Style="{StaticResource Plugin.Button.Primary}"
                        Margin="10,0,0,0"
                        Command="{Binding AddItemCommand}"
                        Content="新增显示项" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Parameter.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Style="{StaticResource Plugin.Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="显示项标题" />
                                    <TextBox
                                        Style="{StaticResource Plugin.TextBox}"
                                        Grid.Column="1"
                                        MinHeight="28"
                                        Margin="0,0,10,0"
                                        Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="2"
                                        Width="82"
                                        Style="{StaticResource Plugin.Button.DangerGhost}"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="删除此项" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource Plugin.Label}" FontWeight="SemiBold" Text="前置文本" />
                                    <TextBox
                                        Style="{StaticResource Plugin.TextBox}"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MinHeight="28"
                                        Margin="0,10,0,0"
                                        Text="{Binding PrefixText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0"
                                        Orientation="Horizontal">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="显示标题"
                                            IsChecked="{Binding IncludeLabel, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="16,0,8,0"
                                            Style="{StaticResource Plugin.Label}"
                                            FontWeight="SemiBold"
                                            Text="空值文本" />
                                        <TextBox
                                            Style="{StaticResource Plugin.TextBox}"
                                            Width="120"
                                            MinHeight="28"
                                            Text="{Binding EmptyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
            </TabItem>
            <TabItem Header="输入与参数绑定">
                <shared:ParameterBindingSection />
            </TabItem>
        </TabControl>

        <Grid
            Grid.Row="1"
            Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="84" Style="{StaticResource Plugin.Button.Secondary}" Command="{Binding ResetCommand}" Content="重置" />
                <Button Width="84" Margin="8,0,0,0" Style="{StaticResource Plugin.Button.Primary}" Command="{Binding ExecuteCommand}" Content="执行" />
            </StackPanel>
            <ScrollViewer
                Grid.Column="0"
                Margin="0,0,16,0"
                MaxHeight="68"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Plugin.Hint}"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
