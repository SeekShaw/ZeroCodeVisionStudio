<UserControl
    x:Class="Plugin.Handle.BinaryThreshold.Views.BinaryThresholdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.Handle.BinaryThreshold"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:ZeroCodeVisionStudio.Shared;assembly=ZeroCodeVisionStudio.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:Plugin.Handle.BinaryThreshold.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:BinaryThresholdViewModel}}"
    d:DesignHeight="520"
    d:DesignWidth="900"
    MinHeight="400"
    MinWidth="640"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 共享插件样式：按钮/输入框/文本卡片，主题感知（DynamicResource Token.*） -->
                <ResourceDictionary Source="pack://application:,,,/ZeroCodeVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider
                x:Key="EMethodProvider"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="{x:Type local:EMethod}" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider
                x:Key="ELightDarkProvider"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="{x:Type shared:ELightDark}" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：图像预览 -->
        <Border
            Grid.Column="0"
            Style="{StaticResource Plugin.PreviewHost}"
            Background="{DynamicResource Theme.Vision.Viewport.Background}">
            <ContentControl Content="{Binding HWindow}" />
        </Border>

        <!-- 右侧：参数设置 + 操作 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 参数编辑区 -->
                        <TabControl Grid.Row="0" Background="Transparent" Style="{StaticResource Plugin.TabControl}">
                <TabItem Header="参数设置">
                    <ScrollViewer
                Padding="20,16,16,12"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource Plugin.Section}" />
                        <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="参数设置" />
                    </StackPanel>
                    <Border Style="{StaticResource Plugin.Card}">
                        <StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Plugin.Label}" Text="方法" />
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource Plugin.ComboBox}"
                                ItemsSource="{Binding Source={StaticResource EMethodProvider}}"
                                SelectedItem="{Binding Parameter.Method, Mode=TwoWay}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Plugin.Label}" Text="亮暗极性" />
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource Plugin.ComboBox}"
                                ItemsSource="{Binding Source={StaticResource ELightDarkProvider}}"
                                SelectedItem="{Binding Parameter.LightDark, Mode=TwoWay}" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </TabItem>
                <TabItem Header="输入与参数绑定">
                    <shared:ParameterBindingSection />
                </TabItem>
            </TabControl>

            <!-- 操作栏 -->
            <Border
                Grid.Row="1"
                Background="{DynamicResource Theme.Vision.ActionBar.Background}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Plugin.Button.Secondary}" Command="{Binding ResetCommand}" Content="重置" />
                    <Button
                        Margin="8,0,0,0"
                        Style="{StaticResource Plugin.Button.Primary}"
                        Command="{Binding ExecuteCommand}"
                        Content="执行" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
