<UserControl
    x:Class="Plugin.Handle.CreateShapeModel.Views.CreateShapeModelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:ZeroCodeVisionStudio.Shared;assembly=ZeroCodeVisionStudio.Shared"
    xmlns:vm="clr-namespace:Plugin.Handle.CreateShapeModel.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:CreateShapeModelViewModel}}"
    d:DesignHeight="640"
    d:DesignWidth="1120"
    MinHeight="500"
    MinWidth="760"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 共享插件样式：按钮/输入框/文本/卡片，主题感知（DynamicResource Token.*） -->
                <ResourceDictionary Source="pack://application:,,,/ZeroCodeVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 语义色别名：基于共享样式（保留原 x:Key，正文无需大改），跟随明暗主题 -->
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource Plugin.TextBox}" />
            <Style x:Key="AppComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource Plugin.ComboBox}" />
            <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Secondary}" />
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Primary}" />
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Secondary}" />
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource Plugin.Button.DangerGhost}" />
            <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource Plugin.Button.Secondary}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Plugin.Label}" />
            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Plugin.Hint}" />
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource Token.Status.Danger}" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PanelHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Token.Surface.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,10" />
            </Style>
            <Style x:Key="ActionBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Token.Surface.Muted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <!-- 编辑器模板 -->
            <DataTemplate x:Key="TextEditorTemplate">
                <TextBox
                    Style="{StaticResource AppTextBoxStyle}"
                    mahs:TextBoxHelper.Watermark="请输入"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
            <DataTemplate x:Key="BoolEditorTemplate">
                <CheckBox
                    Style="{StaticResource AppCheckBoxStyle}"
                    IsChecked="{Binding Value, Mode=TwoWay}" />
            </DataTemplate>
            <DataTemplate x:Key="EnumEditorTemplate">
                <ComboBox
                    Style="{StaticResource AppComboBoxStyle}"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Value, Mode=TwoWay}" />
            </DataTemplate>
            <DataTemplate x:Key="FileSaveEditorTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Style="{StaticResource AppTextBoxStyle}"
                        mahs:TextBoxHelper.Watermark="输入保存路径"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource BrowseButtonStyle}"
                        Command="{Binding DataContext.SaveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="浏览..." />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Token.Surface.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="320" MinWidth="300" MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Plugin.Section}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Plugin.SectionTitle2}"
                            Text="模板区域绘制" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- 绘制/擦除模式切换 -->
                        <Border
                            Margin="0,0,16,0"
                            BorderBrush="{DynamicResource Token.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding SetDrawModeCommand}"
                                    ToolTip="切换到绘制模式">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource SmallButtonStyle}" TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEraserMode}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Token.Primary}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Content>
                                        <TextBlock Text="绘制" />
                                    </Button.Content>
                                </Button>
                                <Button
                                    Command="{Binding SetEraseModeCommand}"
                                    ToolTip="切换到擦除模式">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource SmallButtonStyle}" TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEraserMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Warning.Background}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Content>
                                        <TextBlock Text="擦除" />
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 形状按钮 -->
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Plugin.Label}" Text="形状" />
                        <Button Style="{StaticResource SmallButtonStyle}" Command="{Binding DrawCircleCommand}" Content="圆形" IsEnabled="{Binding IsDrawMode}" />
                        <Button Style="{StaticResource SmallButtonStyle}" Command="{Binding DrawRect1Command}" Content="矩形" IsEnabled="{Binding IsDrawMode}" Margin="6,0,0,0" />
                        <Button Style="{StaticResource SmallButtonStyle}" Command="{Binding DrawRect2Command}" Content="旋转矩形" IsEnabled="{Binding IsDrawMode}" Margin="6,0,0,0" />

                        <!-- 分隔线 -->
                        <Rectangle Width="1" Height="24" Margin="12,0" VerticalAlignment="Center" Fill="{DynamicResource Token.Border.Subtle}" />

                        <!-- 擦除大小 -->
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Plugin.Label}" Text="擦除大小" />
                        <Slider
                            Width="80"
                            Style="{StaticResource AppSliderStyle}"
                            IsEnabled="{Binding IsEraserMode}"
                            Maximum="120"
                            Minimum="1"
                            SmallChange="1"
                            TickFrequency="10"
                            Value="{Binding EraserRadius, Mode=TwoWay}" />
                        <TextBlock
                            MinWidth="32"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Token.Text.Primary}"
                            Text="{Binding EraserRadius, StringFormat=0}" />

                        <!-- 分隔线 -->
                        <Rectangle Width="1" Height="24" Margin="12,0" VerticalAlignment="Center" Fill="{DynamicResource Token.Border.Subtle}" />

                        <!-- 清除按钮 -->
                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearRegionCommand}" Content="清除全部" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 图像预览区 -->
            <Border
                x:Name="HWindowBorder"
                Grid.Row="1"
                Style="{StaticResource Plugin.PreviewHost}"
                Background="{DynamicResource Theme.Vision.Viewport.Background}">
                <Grid>
                    <ContentControl Content="{Binding HWindow}" />
                    <Canvas
                        x:Name="EraserCanvas"
                        Background="Transparent"
                        Cursor="None"
                        IsHitTestVisible="{Binding IsEraserMode}"
                        MouseLeave="EraserCanvas_MouseLeave"
                        MouseLeftButtonDown="EraserCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="EraserCanvas_MouseLeftButtonUp"
                        MouseMove="EraserCanvas_MouseMove">
                        <Ellipse
                            x:Name="EraserCursorEllipse"
                            Fill="Transparent"
                            IsHitTestVisible="False"
                            Stroke="White"
                            StrokeDashArray="3,2"
                            StrokeThickness="2"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Style="{StaticResource ActionBarStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Text="{Binding DrawHint}" />
                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding StatusMessage}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧参数面板 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 参数列表 -->
                        <TabControl Grid.Row="0" Background="Transparent" Style="{StaticResource Plugin.TabControl}">
                <TabItem Header="参数设置">
                                    <ScrollViewer
                                Padding="20,16,16,12"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Style="{StaticResource Plugin.Section}" />
                                        <TextBlock Style="{StaticResource Plugin.SectionTitle2}" Text="模板参数" />
                                    </StackPanel>

                                    <Border Style="{StaticResource Plugin.Card}" Padding="4">
                                        <ItemsControl ItemsSource="{Binding Properties}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Plugin.ListItem}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource LabelStyle}"
                                                                Text="{Binding Name}"
                                                                ToolTip="{Binding Description}" />
                                                            <ContentControl Grid.Column="1" Content="{Binding}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource TextEditorTemplate}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static shared:ParameterEditorKind.Boolean}">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource BoolEditorTemplate}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static shared:ParameterEditorKind.Enum}">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource EnumEditorTemplate}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static shared:ParameterEditorKind.FileSave}">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource FileSaveEditorTemplate}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Style="{StaticResource ErrorTextStyle}"
                                                                Text="{Binding ErrorMessage}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                </TabItem>
                <TabItem Header="输入与参数绑定">
                    <shared:ParameterBindingSection />
                </TabItem>
            </TabControl>

            <!-- 操作按钮 -->
            <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetCommand}" Content="重置" />
                    <Button
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ExecuteCommand}"
                        Content="执行" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
