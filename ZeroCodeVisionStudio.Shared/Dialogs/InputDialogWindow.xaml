<Window
    x:Class="ZeroCodeVisionStudio.Shared.Dialogs.InputDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding TitleText}"
    Height="160"
    Width="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Text="{Binding Prompt}"
            TextWrapping="Wrap" />

        <TextBox
            Grid.Row="1"
            x:Name="InputBox"
            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
            SelectionStart="0"
            FontSize="13"
            Padding="4,2" />

        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                x:Name="CancelBtn"
                Width="75"
                Height="28"
                Margin="0,0,8,0"
                Content="取消"
                Click="CancelBtn_Click" />
            <Button
                x:Name="OkBtn"
                Width="75"
                Height="28"
                Content="确定"
                Click="OkBtn_Click"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
