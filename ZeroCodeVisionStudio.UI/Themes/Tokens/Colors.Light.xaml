<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panels and Background -->
    <SolidColorBrush x:Key="Theme.Vision.Window.Background" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.HeaderBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.SubtleBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Theme.Vision.ActionBar.Background" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Theme.Vision.Viewport.Background" Color="#0F172A" />

    <!-- Borders and Lines -->
    <SolidColorBrush x:Key="Theme.Vision.Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Subtle" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Focus" Color="#3B82F6" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Text.Primary" Color="#0F172A" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Secondary" Color="#475569" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Muted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Inverse" Color="#FFFFFF" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Status.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Background" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Border" Color="#BBF7D0" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Failed" Color="#DC2626" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Background" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Border" Color="#FECACA" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Running" Color="#0284C7" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Background" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Border" Color="#BAE6FD" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Background" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Border" Color="#FDE68A" />

    <!-- Canvas and Connection -->
    <SolidColorBrush x:Key="Theme.Vision.Canvas.Background" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Theme.Vision.Canvas.GridDot" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Line" Color="#94A3B8" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Selected" Color="#3B82F6" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="Theme.Vision.Overlay.Background" Color="#800F172A" />

    <!-- AI Copilot & Modern Semantic Tokens -->
    <SolidColorBrush x:Key="Token.Primary" Color="#2563EB" />
    <SolidColorBrush x:Key="Token.Surface.Background" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Token.Surface.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Token.Surface.Muted" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Token.Border.Subtle" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Token.Text.Primary" Color="#0F172A" />
    <SolidColorBrush x:Key="Token.Text.Secondary" Color="#475569" />
    <SolidColorBrush x:Key="Token.Text.Muted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Token.Status.Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="Token.Status.Danger.Border" Color="#FECACA" />
    <SolidColorBrush x:Key="Token.Status.Danger.Background" Color="#FEE2E2" />

</ResourceDictionary>
