<UserControl
    x:Class="ZeroCodeVisionStudio.Views.Components.MainMenuBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="clr-namespace:ZeroCodeVisionStudio.Shared;assembly=ZeroCodeVisionStudio.Shared"
    Focusable="False">

    <UserControl.Resources>
        <!-- AI 助手渐变画刷 -->
        <LinearGradientBrush x:Key="AiButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AiButtonHoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="1"/>
        </LinearGradientBrush>

        <!-- Logo 渐变 -->
        <LinearGradientBrush x:Key="AppLogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶级菜单项现代悬浮样式 -->
        <Style x:Key="TopLevelMenuItemStyle" BasedOn="{StaticResource MahApps.Styles.MenuItem}" TargetType="MenuItem">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 右侧快捷小图标按钮样式 -->
        <Style x:Key="MenuQuickIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="10,0"
        Height="36"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
        BorderThickness="0,0,0,1"
        CornerRadius="8,8,0,0">
        <DockPanel LastChildFill="True">
            <!-- 左侧：品牌 Logo 与名称 -->
            <StackPanel
                DockPanel.Dock="Left"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="24"
                    Height="24"
                    Background="{StaticResource AppLogoGradient}"
                    CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB" BlurRadius="6" ShadowDepth="1" Opacity="0.25" Direction="270"/>
                    </Border.Effect>
                    <Path
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icon.App}"
                        Fill="Transparent"
                        Stroke="White"
                        StrokeLineJoin="Round"
                        StrokeThickness="2" />
                </Border>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                    Text="智能型工业机器视觉自动化检测平台" />
                
                <!-- 版本/专业版胶囊微标 -->
                <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                        Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Static av:AppVersion.Display}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 纵向分割细线 -->
                <Separator Width="1" Height="14" Margin="10,0,4,0" Background="{DynamicResource Theme.Vision.Border}"/>
            </StackPanel>

            <!-- 右侧：方案标题指示、AI 助手胶囊、快捷工具按钮组 -->
            <StackPanel
                DockPanel.Dock="Right"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!-- 当前方案指示胶囊 -->
                <Border
                    Margin="0,0,8,0"
                    Padding="8,3"
                    Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                    BorderBrush="{DynamicResource Theme.Vision.Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,6,0"/>
                        <TextBlock
                            MaxWidth="200"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                            Text="{Binding SchemeTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- AI 助手快速呼出渐变胶囊按钮 -->
                <Button
                    Command="{Binding ToggleCopilotCommand}"
                    Margin="0,0,8,0"
                    Padding="10,0"
                    Height="28"
                    Cursor="Hand"
                    ToolTip="打开/收起 AI 助手 (Copilot &amp; MCP)">
                    <Button.Effect>
                        <DropShadowEffect Color="#4F46E5" BlurRadius="8" ShadowDepth="1" Opacity="0.28" Direction="270" />
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource AiButtonGradient}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AiButtonHoverGradient}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopilotOpen}" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#A5B4FC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Spark}" Fill="White"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AI 助手" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 快捷启动：执行日志 -->
                <Button Click="OnOpenExecutionLog"
                        Style="{StaticResource MenuQuickIconButtonStyle}"
                        ToolTip="执行运行日志 (F8 / 查看算子与流程耗时)">
                    <Path Width="13" Height="13" Data="{StaticResource Icon.Terminal}"
                          Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                          Style="{StaticResource ToolbarIconPathStyle}"/>
                </Button>

                <!-- 快捷启动：通讯驱动管理 -->
                <Button Click="OnOpenCommunicationManager"
                        Style="{StaticResource MenuQuickIconButtonStyle}"
                        ToolTip="通讯管理 (PLC / 串口 / TCP)">
                    <Path Width="13" Height="13" Data="{StaticResource Icon.Plug}"
                          Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                          Style="{StaticResource ToolbarIconPathStyle}"/>
                </Button>

                <!-- 快捷启动：系统设置 -->
                <Button Click="OnOpenSystemSettings"
                        Style="{StaticResource MenuQuickIconButtonStyle}"
                        Margin="0"
                        ToolTip="系统设置与外观主题">
                    <Path Width="13" Height="13" Data="{StaticResource Icon.Theme}"
                          Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                          Style="{StaticResource ToolbarIconPathStyle}"/>
                </Button>
            </StackPanel>

            <!-- 中间：顶部完整功能菜单栏 -->
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Menu VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12">
                    
                    <!-- 1. 文件菜单 -->
                    <MenuItem Header="文件" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem
                            Click="OnNewSchemeClicked"
                            Header="新建方案"
                            InputGestureText="Ctrl+N">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.New}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding OpenSchemeCommand}" Header="打开方案..." InputGestureText="Ctrl+O">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Open}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- 示例方案：首次启动自动生成，8 个不同方向 -->
                        <MenuItem Header="示例方案">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Spark}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.OpenSchemePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemsSource>
                                <Binding Path="DemoSchemes" />
                            </MenuItem.ItemsSource>
                        </MenuItem>

                        <!-- 最近打开：最多 10 条，文件被删除后自动消失 -->
                        <MenuItem Header="最近打开">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Loop}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="最近打开" />
                                    <Setter Property="ItemsSource" Value="{Binding RecentSchemes}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentSchemes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.OpenSchemePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding SaveSchemeCommand}" Header="保存方案" InputGestureText="Ctrl+S">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Save}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding SaveSchemeAsCommand}" Header="方案另存为..." InputGestureText="Ctrl+Shift+S">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding DeleteSchemeCommand}" Header="删除当前方案文件">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding RenameSchemeCommand}" Header="重命名当前方案..." InputGestureText="F2" />
                        <MenuItem Command="{Binding ManageSchemesCommand}" Header="方案管理（查看全部）..." />
                    </MenuItem>

                    <!-- 2. 编辑菜单 -->
                    <MenuItem Header="编辑" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Command="{Binding UndoCommand}" Header="撤销" InputGestureText="Ctrl+Z">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding RedoCommand}" Header="重做" InputGestureText="Ctrl+Y">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Redo}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding DeleteNodeCommand}" Header="删除选中节点" InputGestureText="Delete">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding DeleteSelectedConnectionCommand}" Header="删除选中连线" InputGestureText="Back">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ClearInputBindingCommand}" Header="清除输入连线绑定">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Remove}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- 3. 流程菜单 -->
                    <MenuItem Header="流程" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Command="{Binding AddWorkflowCommand}" Header="新建工作流" InputGestureText="Ctrl+T">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Add}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding RemoveWorkflowCommand}" Header="删除当前工作流">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Remove}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding HandleExecCommand}" Header="单步执行选中节点" InputGestureText="F6">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Execute}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding StartProcessCommand}" Header="单次运行当前流程" InputGestureText="F5">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Run}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ToggleContinuousRunCommand}" Header="连续循环运行流程" InputGestureText="F7">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Loop}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding StopExecutionCommand}" Header="停止运行流程" InputGestureText="Shift+F5">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- 4. 视图菜单 -->
                    <MenuItem Header="视图" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Command="{Binding ZoomInCommand}" Header="放大画布" InputGestureText="Ctrl++">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.ZoomIn}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ZoomOutCommand}" Header="缩小画布" InputGestureText="Ctrl+-">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.ZoomOut}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ZoomResetCommand}" Header="100% 原始比例重置" InputGestureText="Ctrl+0">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding AutoLayoutCommand}" Header="自动拓扑分层布局" InputGestureText="Ctrl+L"
                                  ToolTip="按拓扑分层重排节点：重心定位缩短连线，减少交叉">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Workflow}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- 5. 工具菜单 -->
                    <MenuItem Header="工具" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Header="系统设置与外观主题..." Click="OnOpenSystemSettings">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Header="通讯驱动管理 (TCP/UDP/串口/PLC)" Click="OnOpenCommunicationManager">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Plug}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="执行运行日志窗口" Click="OnOpenExecutionLog">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Terminal}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="全局变量管理" Click="OnOpenVariableManager">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Link}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- 6. AI 助手菜单 -->
                    <MenuItem Header="AI 助手" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Command="{Binding ToggleCopilotCommand}" Header="打开/收起 AI 助手 (抽屉)" InputGestureText="Ctrl+Space">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Spark}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding Copilot.QuickDiagnoseCommand}" Header="一键智能故障诊断">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Spark}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding Copilot.QuickCreateSchemeCommand}" Header="自动构建视觉流程">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Workflow}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding Copilot.QuickExecuteCommand}" Header="触发流程执行与验证">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Run}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding Copilot.QuickCaptureImageCommand}" Header="视口抓图与多模态分析">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Image}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Command="{Binding Copilot.ToggleSettingsCommand}" Header="AI 与 MCP Server 设置...">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- 7. 帮助菜单 -->
                    <MenuItem Header="帮助" Style="{StaticResource TopLevelMenuItemStyle}">
                        <MenuItem Header="常用快捷键指南..." Click="OnOpenShortcutsHelp">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Bulb}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        
                        <Separator />
                        
                        <MenuItem Header="关于 ZeroCode Vision Studio..." Click="OnOpenAboutDialog">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.App}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                </Menu>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
