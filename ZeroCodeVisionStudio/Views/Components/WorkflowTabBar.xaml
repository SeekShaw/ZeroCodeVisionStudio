<UserControl
    x:Class="ZeroCodeVisionStudio.Views.Components.WorkflowTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程区域标识徽章 -->
        <Border
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="9,5"
            VerticalAlignment="Center"
            Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
            BorderBrush="{DynamicResource Theme.Vision.Border}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path
                    Width="14"
                    Height="14"
                    Data="{StaticResource Icon.Workflow}"
                    Stroke="{DynamicResource MahApps.Brushes.Accent}"
                    Style="{StaticResource ToolbarIconPathStyle}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                    Text="流程" />
            </StackPanel>
        </Border>

        <!-- 中间：流程标签分段底轨与就近管理按钮 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- 标签列表容器（卡片底轨样式） -->
            <Border
                Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ItemsSource="{Binding Workflows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding ActiveWorkflow, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="TabBorder"
                                            MinWidth="80"
                                            Height="28"
                                            Padding="10,0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="重命名流程..."
                                                              Command="{Binding PlacementTarget.Tag.RenameWorkflowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="删除流程"
                                                              Command="{Binding PlacementTarget.Tag.RemoveWorkflowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Ellipse
                                                    x:Name="TabIndicator"
                                                    Width="6"
                                                    Height="6"
                                                    Margin="0,0,6,0"
                                                    Fill="{DynamicResource Theme.Vision.Text.Muted}" />
                                                <TextBlock
                                                    x:Name="TabText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Normal"
                                                    Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                                                    Text="{Binding WorkflowName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Vision.Panel.Background}" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Theme.Vision.Border}" />
                                                <Setter TargetName="TabIndicator" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 流程增减快捷操作组（紧邻标签栏，消除远距离割裂） -->
            <Border
                Margin="6,0,0,0"
                Background="{DynamicResource Theme.Vision.Panel.HeaderBackground}"
                BorderBrush="{DynamicResource Theme.Vision.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding AddWorkflowCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="新建流程 (添加工作流标签)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource Icon.Add}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Separator Width="1" Height="14" Margin="1,0" Background="{DynamicResource Theme.Vision.Border}" />
                    <Button
                        Command="{Binding RemoveWorkflowCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="删除当前流程">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource Icon.Remove}"
                                        Stroke="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background.MouseOver}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 右侧：执行 + 历史操作控制区 -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- 1. 所有启动 -->
            <Button Command="{Binding StartProcessCommand}" Height="32" Margin="0,0,6,0">
                <Button.ToolTip>
                    <ToolTip Content="运行整条流程 (F5)" />
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Data="M4,2 L4,12 L12,7 Z"
                                      Fill="{StaticResource RunGreenBrush}" Style="{StaticResource ToolbarIconPathStyle}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource RunGreenBrush}" Text="所有启动" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RunGreenHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 2. 所有停止 -->
            <Button Command="{Binding StopExecutionCommand}" Height="32" Margin="0,0,12,0">
                <Button.ToolTip>
                    <ToolTip Content="停止所有 (Esc)" />
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Data="M4.5,4.5 H11.5 V11.5 H4.5 Z"
                                      Fill="{StaticResource StopRedBrush}" Style="{StaticResource ToolbarIconPathStyle}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource StopRedBrush}" Text="所有停止" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StopRedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 分组分隔线 -->
            <Separator Width="1" Height="18" Margin="2,0,10,0" Background="{DynamicResource Theme.Vision.Border}" />
        </StackPanel>
    </Grid>
</UserControl>
