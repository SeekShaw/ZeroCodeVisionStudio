<mahs:MetroWindow
    x:Class="ZeroCodeVisionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ZeroCodeVisionStudio.UI.Controls;assembly=ZeroCodeVisionStudio.UI"
    xmlns:components="clr-namespace:ZeroCodeVisionStudio.Views.Components"
    xmlns:views="clr-namespace:ZeroCodeVisionStudio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZeroCodeVisionStudio"
    xmlns:mahs="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding SchemeTitle}"
    Width="1400"
    Height="820"
    MinWidth="1024"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    d:DataContext="{d:DesignInstance Type={x:Type local:MainViewModel}}"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
    mc:Ignorable="d">
    <mahs:MetroWindow.Resources>
        <!-- 预定义竖向工具栏用的硬编码颜色 Brush，用 SolidColorBrush 避免简体中文环境 Brush.Parse 文化敏感崩溃 -->
        <SolidColorBrush x:Key="ToolboxIconBrush" Color="#212121" />
        <SolidColorBrush x:Key="ToolboxRailBgBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ToolboxRailBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="ToolboxDividerBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="ToolboxPanelBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolboxArrowBrush" Color="#757575" />
        <SolidColorBrush x:Key="ToolboxPlaceholderBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="ToolboxTransparentBrush" Color="#00000000" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="VerticalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource ToolboxTransparentBrush}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{DynamicResource MahApps.Brushes.Gray5}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource ToolboxTransparentBrush}" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Height="1"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource MahApps.Brushes.Gray5}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mahs:MetroWindow.Resources>
    <mahs:MetroWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSchemeCommand}" />
    </mahs:MetroWindow.InputBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <components:MainMenuBar Grid.Row="0" />

                <components:WorkflowTabBar Grid.Row="1" Margin="10,5" />
            </Grid>
        </Border>

        <!-- Row1: 主工作区 - 5 列 Grid，两个 Splitter 都在 Star↔Star 之间，竖栏在画布 Col4 内部用 DockPanel.Dock=Left 固定 52px -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Col0: Toolbox (固定宽度 300px，可由 Splitter 微调) -->
                <ColumnDefinition x:Name="ToolboxColumn" Width="300" MinWidth="280" />
                <!-- Col1: Splitter Toolbox ↔ Workflow -->
                <ColumnDefinition Width="4" />
                <!-- Col2: Workflow Editor (Star, 用户可拖 Splitter 调节) -->
                <ColumnDefinition Width="1.5*" MinWidth="300" />
                <!-- Col3: Splitter Workflow ↔ Canvas -->
                <ColumnDefinition Width="4" />
                <!-- Col4: Canvas area — 内部 DockPanel 竖栏 Dock=Left 52px + 画布填充剩余 -->
                <ColumnDefinition Width="*" MinWidth="502" />
            </Grid.ColumnDefinitions>

            <!-- Col0: Toolbox -->
            <Border Grid.Column="0" Margin="0,0,4,0"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                    BorderThickness="1" CornerRadius="4">
                <controls:ToolboxPanel x:Name="MainToolboxPanel" AddNodeCommand="{Binding AddNodeCommand}" ItemsSource="{Binding HandleControl.HandleView}" />
            </Border>

            <!-- Col1 Splitter: Toolbox ↔ Workflow -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray5}" Cursor="SizeWE" />

            <!-- Col2: Workflow Editor with Popup overlay -->
            <Border x:Name="WorkflowHostBorder" Grid.Column="2" Margin="4,0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <controls:WorkflowEditor
                        AddNodeCommand="{Binding AddNodeCommand}"
                        AutoLayoutCommand="{Binding AutoLayoutCommand}"
                        ConnectNodesCommand="{Binding AddConnectionCommand}"
                        Connections="{Binding Connections}"
                        DeleteConnectionCommand="{Binding DeleteConnectionCommand}"
                        DeleteSelectedConnectionCommand="{Binding DeleteSelectedConnectionCommand}"
                        MoveNodeCommand="{Binding MoveNodeCommand}"
                        NodeDeleteCommand="{Binding DeleteNodeCommand}"
                        NodeEditCommand="{Binding HandleEditCommand}"
                        NodeExecuteCommand="{Binding HandleExecCommand}"
                        NodeConditionCommand="{Binding SetNodeConditionCommand}"
                        NodeRenameCommand="{Binding NodeRenameCommand}"
                        Nodes="{Binding Nodes}"
                        SelectConnectionCommand="{Binding SelectConnectionCommand}"
                        RedoCommand="{Binding RedoCommand}"
                        SelectNodeCommand="{Binding SelectNodeCommand}"
                        SetInputBindingCommand="{Binding SetInputBindingCommand}"
                        StopExecutionCommand="{Binding StopExecutionCommand}"
                        UndoCommand="{Binding UndoCommand}"
                        ZoomInCommand="{Binding ZoomInCommand}"
                        ZoomOutCommand="{Binding ZoomOutCommand}"
                        ZoomResetCommand="{Binding ZoomResetCommand}"
                        WorkflowScale="{Binding WorkflowScale}" />

                    <!-- Popup anchor (1x1px at workflow top-right, below auto-layout buttons) -->
                    <Border x:Name="PopupAnchor" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="1" Height="1" Margin="0,52,12,0" />

                    <!-- Toolbar Popup -->
                    <Popup AllowsTransparency="True"
                           IsOpen="{Binding ToolbarPanelExpanded, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=PopupAnchor}"
                           Placement="Left"
                           PopupAnimation="Slide"
                           StaysOpen="True">
                        <Border Width="280" MaxHeight="480" Margin="0,4,4,0"
                                Background="{StaticResource ToolboxPanelBgBrush}"
                                BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="14,12,10,10">
                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Right" Width="22" Height="22" Margin="4,0,0,0"
                                                Command="{Binding ToggleToolbarPanelCommand}" ToolTip="关闭"
                                                Background="{StaticResource ToolboxTransparentBrush}"
                                                BorderThickness="0" FontSize="13" FontWeight="Bold"
                                                Foreground="{StaticResource ToolboxArrowBrush}" Padding="0">
                                            <TextBlock Text="✕" />
                                        </Button>
                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource ToolboxIconBrush}"
                                                   Text="{Binding ActiveToolbarPanelTitle}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="14,0,14,0"
                                        Background="{StaticResource ToolboxDividerBrush}" />
                                <Grid Grid.Row="1" Margin="14,16">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12"
                                               Foreground="{StaticResource ToolboxPlaceholderBrush}"
                                               Text="功能内容待实现..." />
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Col3 Splitter: Workflow ↔ Canvas -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray5}" Cursor="SizeWE" />

            <!-- Col4: Canvas Area = DockPanel (竖栏 Dock=Left 52px + 画布填充剩余) -->
            <DockPanel Grid.Column="4">
                <!-- 竖栏：DockPanel.Dock="Left" Width="52" — 永远固定 52px 在画布区域左边缘 -->
                <Border DockPanel.Dock="Left" Width="52" Margin="4,0,4,0"
                        Background="{StaticResource ToolboxRailBgBrush}"
                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8">
                        <Button Width="40" Height="40" Margin="0,0,0,6" Command="{Binding SelectInfoTab0Command}" ToolTip="模块结果"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <Path Data="M4,2 H12 V14 H4 Z M6,5 H10 M6,8 H10 M6,11 H8" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="2" Fill="{StaticResource ToolboxTransparentBrush}" />
                        </Button>
                        <Button Width="40" Height="40" Margin="0,0,0,6" Command="{Binding SelectInfoTab1Command}" ToolTip="输入绑定"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <Path Data="M5,4 L13,4 M13,4 L13,8 A4,4 0 0,1 9,12 A4,4 0 0,1 5,8 L5,4 M8,12 L8,14 M10,14 L8,16 L6,14" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="2" Fill="{StaticResource ToolboxTransparentBrush}" />
                        </Button>
                        <Button Width="40" Height="40" Margin="0,0,0,6" Command="{Binding SelectInfoTab2Command}" ToolTip="流程日志"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <Path Data="M3,3 H13 V4 H3 Z M3,6 H13 V7 H3 Z M3,9 H10 V10 H3 Z M3,12 H8 V13 H3 Z" Fill="{StaticResource ToolboxIconBrush}" />
                        </Button>
                        <Button Width="40" Height="40" Margin="0,0,0,6" Command="{Binding SelectInfoTab3Command}" ToolTip="参数配置"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <Path Data="M12,3 L14,6 L18,6 L15,8 L16,12 L12,10 L8,12 L9,8 L6,6 L10,6 Z" Fill="{StaticResource ToolboxIconBrush}" />
                        </Button>
                        <Button Width="40" Height="40" Margin="0,0,0,6" Command="{Binding SelectInfoTab4Command}" ToolTip="调试监控"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <Path Data="M4,12 L8,8 L11,11 L15,6 L20,12 L20,16 L4,16 Z" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="2" Fill="{StaticResource ToolboxTransparentBrush}" />
                        </Button>
                        <Border Height="1" Width="32" Background="{StaticResource ToolboxDividerBrush}" Margin="0,8,0,8" />
                        <Button Width="40" Height="40" Command="{Binding ToggleToolbarPanelCommand}" ToolTip="展开/收起功能面板"
                                Background="{StaticResource ToolboxTransparentBrush}" BorderThickness="0">
                            <TextBlock Text="{Binding ToolbarArrowText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ToolboxIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 画布 Grid 填充剩余空间 -->
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.1*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  显示面板  -->
                <Border
                    Grid.Row="0"
                    Margin="4,0,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  标题行：显示  -->
                        <Grid Margin="12,10,12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="显示" />
                                <TextBlock
                                    Margin="10,2,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="当前算子执行结果" />
                            </StackPanel>
                        </Grid>

                        <!--  显示窗口（Halcon HSmartWindow + OpenCV WPF Image 双引擎降级）  -->
                        <Border
                            Grid.Row="1"
                            x:Name="ImageViewportBorder"
                            Margin="10,0,10,0"
                            Background="{DynamicResource Theme.Vision.Viewport.Background}"
                            CornerRadius="4"
                            MouseWheel="ImageViewportBorder_MouseWheel">
                            <Grid>
                                <!--  Halcon 原生窗口（可用时显示）  -->
                                <ContentControl
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding HWindow}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHalconAvailable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!--  OpenCV / WPF 降级图像（DisplayBitmap 非 null 时显示）  -->
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="None"
                                    Source="{Binding DisplayBitmap}">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}" />
                                    </Image.LayoutTransform>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <!-- 默认 Visible（Setter），DisplayBitmap=null 时 Trigger 切 Collapsed -->
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayBitmap}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!--  右上角缩放工具栏（覆盖层，整体右对齐）  -->
                                <DockPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8,8,8,0">

                                    <!--  缩放百分比（最右）  -->
                                    <Border
                                        DockPanel.Dock="Left"
                                        Margin="0,0,4,0"
                                        Padding="10,4"
                                        Background="{StaticResource ToolboxPanelBgBrush}"
                                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ToolboxIconBrush}"
                                            Text="{Binding DisplayScalePercent, Mode=OneWay}" />
                                    </Border>

                                    <!--  缩小  -->
                                    <Button
                                        DockPanel.Dock="Left"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        Command="{Binding ImageZoomOutCommand}"
                                        ToolTip="缩小 (Ctrl+滚轮下)"
                                        Background="{StaticResource ToolboxPanelBgBrush}"
                                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                        BorderThickness="1">
                                        <Path Data="M4,7 H12" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="2" />
                                    </Button>

                                    <!--  自适应窗口  -->
                                    <Button
                                        DockPanel.Dock="Left"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        Command="{Binding ImageZoomFitCommand}"
                                        ToolTip="自适应窗口"
                                        Background="{StaticResource ToolboxPanelBgBrush}"
                                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                        BorderThickness="1">
                                        <Path Data="M3,3 H13 V13 H3 Z M5,5 H11 V11 H5 Z" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="1.5" Fill="{StaticResource ToolboxTransparentBrush}" />
                                    </Button>

                                    <!--  1:1 实际大小  -->
                                    <Button
                                        DockPanel.Dock="Left"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        Command="{Binding ImageZoomActualCommand}"
                                        ToolTip="实际大小 (100%)"
                                        Background="{StaticResource ToolboxPanelBgBrush}"
                                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                        BorderThickness="1">
                                        <Path Data="M4,4 L7,4 L7,6 L6,6 L6,9 L4,9 Z M8,4 L12,4 L12,8 L8,8 L8,6 Z M4,10 L8,10 L8,13 L4,13 Z M9,9 L12,9 L12,13 L9,13 Z" Fill="{StaticResource ToolboxIconBrush}" />
                                    </Button>

                                    <!--  放大  -->
                                    <Button
                                        DockPanel.Dock="Left"
                                        Width="30"
                                        Height="28"
                                        Command="{Binding ImageZoomInCommand}"
                                        ToolTip="放大 (Ctrl+滚轮上)"
                                        Background="{StaticResource ToolboxPanelBgBrush}"
                                        BorderBrush="{StaticResource ToolboxRailBorderBrush}"
                                        BorderThickness="1">
                                        <Path Data="M4,7 H12 M8,3 V11" Stroke="{StaticResource ToolboxIconBrush}" StrokeThickness="2" />
                                    </Button>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!--  底部面板：工具条 + 缩略图条（画布下方）  -->
                        <Border
                            Grid.Row="2"
                            Margin="10,4,10,0"
                            Padding="0"
                            Background="{DynamicResource Theme.Vision.Viewport.Background}"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  工具条  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="10,6"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 缩略图展开/隐藏 toggle -->
                                        <Button
                                            Grid.Column="0"
                                            Width="28"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Command="{Binding ToggleThumbnailPanelCommand}"
                                            Style="{StaticResource SchemeButtonStyle}"
                                            ToolTip="展开/隐藏缩略图">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Text="▼">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThumbnailPanelExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Text="▶">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThumbnailPanelExpanded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- 第一张 -->
                                        <Button
                                            Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,2,0"
                                            Padding="0"
                                            Command="{Binding SelectFirstThumbnailCommand}"
                                            Style="{StaticResource SchemeButtonStyle}"
                                            ToolTip="第一张">
                                            <TextBlock Text="⏮" FontSize="11" />
                                        </Button>

                                        <!-- 上一张 -->
                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,2,0"
                                            Padding="0"
                                            Command="{Binding SelectPrevThumbnailCommand}"
                                            Style="{StaticResource SchemeButtonStyle}"
                                            ToolTip="上一张">
                                            <TextBlock Text="◀" FontSize="11" />
                                        </Button>

                                        <!-- 下一张 -->
                                        <Button
                                            Grid.Column="3"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,2,0"
                                            Padding="0"
                                            Command="{Binding SelectNextThumbnailCommand}"
                                            Style="{StaticResource SchemeButtonStyle}"
                                            ToolTip="下一张">
                                            <TextBlock Text="▶" FontSize="11" />
                                        </Button>

                                        <!-- 最后一张 -->
                                        <Button
                                            Grid.Column="4"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            Command="{Binding SelectLastThumbnailCommand}"
                                            Style="{StaticResource SchemeButtonStyle}"
                                            ToolTip="最后一张">
                                            <TextBlock Text="⏭" FontSize="11" />
                                        </Button>

                                        <!-- 占位（把序号推到右边）  -->
                                        <Border Grid.Column="5" />

                                        <!-- 当前序号  格式: "1 / 598"  -->
                                        <TextBlock
                                            Grid.Column="6"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource MahApps.Brushes.Gray2}">
                                            <Run Text="{Binding SelectedThumbnailIndex, Mode=OneWay}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding Thumbnails.Count, Mode=OneWay}" />
                                        </TextBlock>

                                        <!--  执行到选定节点 / 单次循环 / 连续运行（Col7，序号右侧）  -->
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="12,0,0,0">
                                            <!-- 执行到选定节点：运行整条流程到当前选中的节点为止，后续节点不执行 -->
                                            <Button Width="32" Height="24" Margin="0,0,4,0" Padding="0"
                                                    Command="{Binding ExecuteToSelectedNodeCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTipService.ShowDuration="10000"
                                                    ToolTipService.InitialShowDelay="300"
                                                    Background="{StaticResource ToolboxPanelBgBrush}" BorderBrush="{StaticResource IconDarkBrush}" BorderThickness="1" Cursor="Hand">
                                                <Button.ToolTip>
                                                    <ToolTip Content="运行到当前指定流程节点为止（后续节点不执行）" />
                                                </Button.ToolTip>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M4,2 L4,12 L12,7 Z"
                                                          Width="10" Height="10"
                                                          Fill="{StaticResource RunGreenBrush}" />
                                                    <TextBlock Text="▶" FontSize="9" FontWeight="Bold" Margin="1,0,0,0"
                                                               Foreground="{StaticResource IconDarkBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <!-- 单次循环：空闲→圆弧+箭头图标；运行中→"停止"文字。背景：空闲绿、运行红  -->
                                            <Button Width="34" Height="24" Margin="0,0,4,0" Padding="0"
                                                    Command="{Binding ToggleSingleLoopCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    BorderThickness="1" FontSize="10" Foreground="{StaticResource IconWhiteBrush}">
                                                <Button.ToolTip>
                                                    <ToolTip Content="单次循环（从第一张到最后一张，跑完自动停止）" />
                                                </Button.ToolTip>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- 图标：18×18，纯黑加粗描边 -->
                                                    <Path Data="M3,4 A6,6 0 1 0 9,9 L7,9 M9,9 L9,7"
                                                          Width="18" Height="18"
                                                          Stroke="{StaticResource IconDarkBrush}" StrokeThickness="2"
                                                          Fill="{StaticResource ToolboxTransparentBrush}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSingleLoopRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <!-- "停止"文字（运行中显示）  -->
                                                    <TextBlock Text="停止" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource IconWhiteBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSingleLoopRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource RunGreenBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource RunGreenHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSingleLoopRunning}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource StopRedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource StopRedHoverBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- 连续运行：空闲→双向箭头循环图标；运行中→"停止"文字。背景：空闲绿、运行红  -->
                                            <Button Width="34" Height="24" Padding="0"
                                                    Command="{Binding ToggleContinuousRunCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    BorderThickness="1" FontSize="10" Foreground="{StaticResource IconWhiteBrush}">
                                                <Button.ToolTip>
                                                    <ToolTip Content="连续运行（从第一张到最后一张无限循环，再次点击停止）" />
                                                </Button.ToolTip>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- 图标：18×16，纯黑加粗描边 -->
                                                    <Path Data="M2,5 H13 M11,3 L14,5 L11,7 M15,11 H4 M6,9 L3,11 L6,13"
                                                          Width="18" Height="16"
                                                          Stroke="{StaticResource IconDarkBrush}" StrokeThickness="2"
                                                          Fill="{StaticResource ToolboxTransparentBrush}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsContinuousRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="停止" FontSize="10"
                                                               Foreground="{StaticResource IconWhiteBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsContinuousRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource RunGreenBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource RunGreenHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsContinuousRunning}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource StopRedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource StopRedHoverBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--  缩略图条（展开时显示）  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    MaxHeight="72"
                                    Margin="2,0"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThumbnailPanelExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding Thumbnails}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="0" Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="3,4"
                                                    Padding="0"
                                                    Width="64"
                                                    Height="56"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                                    Background="{StaticResource ToolboxTransparentBrush}"
                                                    Command="{Binding DataContext.SelectThumbnailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Image
                                                        Width="60"
                                                        Height="52"
                                                        Stretch="Uniform"
                                                        Source="{Binding Thumbnail}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            MaxWidth="320"
                            Margin="20,12"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{Binding DisplayOverlayBackground}"
                            CornerRadius="6"
                            Visibility="{Binding HasDisplayOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{Binding DisplayOverlayForeground}"
                                Text="{Binding DisplayOverlayText}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Margin="24"
                            Padding="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MahApps.Brushes.Control.Background}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHalconAvailable}" Value="False" />
                                                <Condition Binding="{Binding DisplayBitmap}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                MaxWidth="520"
                                Foreground="{DynamicResource MahApps.Brushes.Text}"
                                Text="{Binding HalconUnavailableMessage}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter
                    Grid.Row="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource HorizontalPaneSplitterStyle}" />

                <!--  底部：TabControl - 模块结果 / 输入绑定  -->
                <Border
                    Grid.Row="2"
                    Margin="4,0,0,0"
                    Style="{StaticResource PanelBorderStyle}">

                    <mahs:MetroTabControl
                        Margin="10,6,10,10"
                        mahs:TabControlHelper.Underlined="TabPanel"
                        Background="{StaticResource ToolboxTransparentBrush}"
                        BorderThickness="0"
                        SelectedIndex="{Binding SelectedInfoTab, Mode=TwoWay}"
                        Style="{DynamicResource MahApps.Styles.TabControl.Animated}">
                        <mahs:MetroTabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </mahs:MetroTabControl.ItemTemplate>

                        <!--  Tab 1：模块结果  -->
                        <TabItem Header="模块结果">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    Margin="2,4,0,4"
                                    MaxHeight="58"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                        Text="{Binding ResultMessage}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                                <DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    GridLinesVisibility="Horizontal"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ExecutionRecords}"
                                    SelectedItem="{Binding SelectedExecutionRecord, Mode=TwoWay}"
                                    controls:DataGridAutoScrollHelper.AutoScrollToBottom="True"
                                    controls:DataGridAutoScrollHelper.ScrollToSelectedItem="True"
                                    RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="54"
                                            Binding="{Binding Sequence}"
                                            Header="序号" />
                                        <DataGridTextColumn
                                            Width="88"
                                            Binding="{Binding ExecuteTime, StringFormat=HH:mm:ss}"
                                            Header="执行时间" />
                                        <DataGridTextColumn
                                            Width="110"
                                            Binding="{Binding Module}"
                                            Header="模块" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding StatusText}"
                                            Header="状态" />
                                        <DataGridTextColumn
                                            Width="82"
                                            Binding="{Binding ElapsedText}"
                                            Header="耗时" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding ResultData}"
                                            Header="结果数据" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!--  Tab 2：输入绑定（绑定值优先于算子参数中的手动值）  -->
                        <TabItem Header="输入绑定">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="2,4,0,6"
                                    FontSize="11"
                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                    Text="已设置绑定的参数在执行时优先使用上游节点的输出值。"
                                    TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedInputBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Margin="0,0,0,4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                            Text="{Binding InputName}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Description}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="52" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                MinHeight="26"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding Options}"
                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding ClearCommand}"
                                                                Content="清除" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </mahs:MetroTabControl>
                </Border>
            </Grid>
        </DockPanel>
            </Grid>

        <!-- AI 助手抽屉 (Copilot & MCP) -->
        <Border
            Grid.RowSpan="2"
            Width="420"
            HorizontalAlignment="Right"
            Panel.ZIndex="35"
            Background="{DynamicResource Token.Surface.Card}"
            BorderBrush="{DynamicResource Token.Border.Subtle}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding IsCopilotOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:VisionCopilotPanel DataContext="{Binding Copilot}" />
        </Border>

        
        <Border
            Grid.RowSpan="2"
            Background="{DynamicResource Theme.Vision.Overlay.Background}"
            Panel.ZIndex="50"
            Visibility="{Binding IsSchemeLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="StackPanel.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="SchemeLoadingRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0"
                                        To="360"
                                        Duration="0:0:1.1" />
                                    <DoubleAnimation
                                        AutoReverse="True"
                                        Storyboard.TargetName="SchemeLoadingPulse"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.35"
                                        To="0.9"
                                        Duration="0:0:0.65" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Grid Width="78" Height="78">
                        <Ellipse
                            Stroke="{DynamicResource MahApps.Brushes.Text}"
                            StrokeThickness="8" />
                        <Ellipse
                            Stroke="{DynamicResource Theme.Vision.Status.Running}"
                            StrokeDashArray="1,3"
                            StrokeDashCap="Round"
                            StrokeThickness="8">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SchemeLoadingRotate" CenterX="39" CenterY="39" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="SchemeLoadingPulse"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Theme.Vision.Status.Success}" />
                    </Grid>
                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding SchemeLoadingMessage}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Vision.Text.Muted}"
                        Text="请稍候，正在重建流程画布和节点绑定" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mahs:MetroWindow>


