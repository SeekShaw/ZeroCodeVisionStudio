<Window
    x:Class="ZeroCodeVisionStudio.Views.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:av="clr-namespace:ZeroCodeVisionStudio.Shared;assembly=ZeroCodeVisionStudio.Shared"
    Title="ZeroCodeVisionStudio"
    Width="720"
    Height="430"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <!-- 主卡片容器：外层留出 20px 边距以完整容纳柔和阴影，消除硬切边 -->
        <Border
            Margin="20"
            BorderThickness="1"
            CornerRadius="18">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#475569" />
                    <GradientStop Offset="0.3" Color="#38BDF8" />
                    <GradientStop Offset="0.8" Color="#1E293B" />
                    <GradientStop Offset="1" Color="#0F172A" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0B0F19" />
                    <GradientStop Offset="0.5" Color="#0E1626" />
                    <GradientStop Offset="1" Color="#090D15" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="32"
                    Direction="270"
                    Opacity="0.6"
                    ShadowDepth="10"
                    Color="#000000" />
            </Border.Effect>

            <!-- 卡片内部剪裁层 -->
            <Grid ClipToBounds="True">
                <!-- 主区域网格拆分：属性元素必须位于最前面 -->
                <Grid.RowDefinitions>
                    <!-- 顶部标题栏 -->
                    <RowDefinition Height="64" />
                    <!-- 中间视觉特征展示区 -->
                    <RowDefinition Height="*" />
                    <!-- 进度指示区 -->
                    <RowDefinition Height="Auto" />
                    <!-- 底部系统指标栏 -->
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <!-- 背景氛围光晕 1：顶部深蓝光晕 -->
                <Ellipse
                    Grid.RowSpan="4"
                    Width="360"
                    Height="240"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="-80,-60,0,0"
                    IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="#2563EB" />
                            <GradientStop Offset="0.7" Color="#1D4ED8" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Opacity>0.22</Ellipse.Opacity>
                </Ellipse>

                <!-- 背景氛围光晕 2：右下青绿光晕 -->
                <Ellipse
                    Grid.RowSpan="4"
                    Width="320"
                    Height="200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,-60,-40"
                    IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="#06B6D4" />
                            <GradientStop Offset="0.7" Color="#0284C7" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Opacity>0.15</Ellipse.Opacity>
                </Ellipse>

                <!-- 工业视觉标定十字背景微水印 -->
                <Canvas Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.18">
                    <!-- 左上十字标 -->
                    <Path Data="M 35,45 L 45,45 M 40,40 L 40,50" Stroke="#38BDF8" StrokeThickness="1" />
                    <!-- 右上十字标 -->
                    <Path Data="M 635,45 L 645,45 M 640,40 L 640,50" Stroke="#38BDF8" StrokeThickness="1" />
                    <!-- 标定微点阵 -->
                    <Ellipse Width="3" Height="3" Fill="#38BDF8" Canvas.Left="220" Canvas.Top="60" Opacity="0.5" />
                    <Ellipse Width="3" Height="3" Fill="#38BDF8" Canvas.Left="420" Canvas.Top="60" Opacity="0.5" />
                    <Ellipse Width="3" Height="3" Fill="#38BDF8" Canvas.Left="320" Canvas.Top="180" Opacity="0.3" />
                </Canvas>

                <!-- ==================== 1. 顶部标题栏 ==================== -->
                <Grid Grid.Row="0" Margin="28,16,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：矢量图标 + 标题 + 版本徽章 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 矢量 Logo 图标：光学棱镜与光束 -->
                        <Border
                            Width="34"
                            Height="34"
                            CornerRadius="8"
                            Margin="0,0,14,0"
                            BorderBrush="#38BDF8"
                            BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1E40AF" />
                                    <GradientStop Offset="1" Color="#0284C7" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.4" />
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path
                                    Data="M 0,10 L 8,0 L 16,10 L 8,20 Z"
                                    Stroke="#FFFFFF"
                                    StrokeThickness="2"
                                    Fill="#38BDF8"
                                    Opacity="0.8" />
                                <Ellipse Width="6" Height="6" Fill="#FFFFFF" />
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe UI, Microsoft YaHei UI"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Text="ZEROCODE VISION STUDIO">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="#38BDF8" Opacity="0.3" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <!-- 版本徽章 -->
                                <Border
                                    Margin="10,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#1E293B"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#38BDF8"
                                        Text="{x:Static av:AppVersion.Display}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#64748B"
                                Text="INDUSTRIAL MACHINE VISION PLATFORM" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：系统就绪状态灯 -->
                    <Border
                        Grid.Column="1"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 呼吸发光绿灯 -->
                            <Ellipse
                                x:Name="StatusDot"
                                Width="7"
                                Height="7"
                                Margin="0,0,7,0"
                                Fill="#10B981">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="#94A3B8"
                                Text="SYSTEM INITIALIZING" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== 2. 中间视觉特征展示区 ==================== -->
                <Grid Grid.Row="1" Margin="28,10,28,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：动态光学镜头 / 视觉标定靶标 -->
                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 镜头外圆环（顺时针旋转） -->
                        <Border
                            Width="110"
                            Height="110"
                            BorderBrush="#1E3A8A"
                            BorderThickness="1.5"
                            CornerRadius="55">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="OuterRingRotate" CenterX="55" CenterY="55" Angle="0" />
                            </Border.RenderTransform>
                            <!-- 刻度线 -->
                            <Canvas Width="110" Height="110">
                                <Rectangle Width="4" Height="2" Fill="#38BDF8" Canvas.Left="0" Canvas.Top="54" Opacity="0.7" />
                                <Rectangle Width="4" Height="2" Fill="#38BDF8" Canvas.Left="106" Canvas.Top="54" Opacity="0.7" />
                                <Rectangle Width="2" Height="4" Fill="#38BDF8" Canvas.Left="54" Canvas.Top="0" Opacity="0.7" />
                                <Rectangle Width="2" Height="4" Fill="#38BDF8" Canvas.Left="54" Canvas.Top="106" Opacity="0.7" />
                            </Canvas>
                        </Border>

                        <!-- 镜头次外环虚线（逆时针旋转） -->
                        <Border
                            Width="90"
                            Height="90"
                            BorderBrush="#0284C7"
                            BorderThickness="1"
                            CornerRadius="45">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="InnerRingRotate" CenterX="45" CenterY="45" Angle="0" />
                            </Border.RenderTransform>
                            <Path
                                Data="M 15,45 A 30,30 0 1 1 75,45 A 30,30 0 1 1 15,45"
                                Stroke="#0EA5E9"
                                StrokeThickness="1"
                                StrokeDashArray="4, 5"
                                Opacity="0.5" />
                        </Border>

                        <!-- 镜头玻璃镀膜光泽背景 -->
                        <Ellipse Width="70" Height="70" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.4,0.35" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Offset="0" Color="#1E293B" />
                                    <GradientStop Offset="0.6" Color="#0F172A" />
                                    <GradientStop Offset="1" Color="#0284C7" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Opacity>0.7</Ellipse.Opacity>
                        </Ellipse>

                        <!-- 镜头十字交叉准星 -->
                        <Path
                            Data="M 25,55 L 45,55 M 65,55 L 85,55 M 55,25 L 55,45 M 55,65 L 55,85"
                            Stroke="#38BDF8"
                            StrokeThickness="1"
                            Opacity="0.8" />

                        <!-- 激光扫描线（垂直往复平移） -->
                        <Rectangle
                            x:Name="LaserScanner"
                            Width="64"
                            Height="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.5" Color="#38BDF8" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" Opacity="0.9" />
                            </Rectangle.Effect>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ScannerTranslate" Y="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- 中心对焦脉冲光点 -->
                        <Ellipse
                            x:Name="CenterFocusDot"
                            Width="8"
                            Height="8"
                            Fill="#10B981"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#10B981" Opacity="0.9" />
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CenterPulseScale" CenterX="4" CenterY="4" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <!-- 右侧：平台标语与特性能力标签 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock
                            FontFamily="Segoe UI, Microsoft YaHei UI"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#F1F5F9"
                            Text="智能型工业机器视觉自动化检测平台" />
                        <TextBlock
                            Margin="0,5,0,16"
                            FontFamily="Segoe UI"
                            FontSize="11.5"
                            Foreground="#64748B"
                            Text="Next-Gen Intelligent Machine Vision Inspection &amp; Workflow Execution" />

                        <!-- 平台三大核心能力胶囊标签 -->
                        <WrapPanel Orientation="Horizontal">
                            <Border
                                Margin="0,0,8,8"
                                Padding="10,5"
                                Background="#10192A"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#38BDF8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="亚像素高精测量" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,0,8,8"
                                Padding="10,5"
                                Background="#10192A"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#818CF8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="形状与轮廓匹配" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,0,8,8"
                                Padding="10,5"
                                Background="#10192A"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#34D399" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="毫秒级并行流水线" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- ==================== 3. 底部加载与进度区域 ==================== -->
                <Grid Grid.Row="2" Margin="28,0,28,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 进度描述行：左侧当前阶段说明，右侧百分比数字 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 人类可读步骤说明 -->
                        <TextBlock
                            x:Name="LoadDetailText"
                            Grid.Column="0"
                            FontFamily="Segoe UI, Microsoft YaHei UI"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            Text="正在扫描视觉算法模块..." />

                        <!-- 百分比数字 -->
                        <TextBlock
                            x:Name="PercentText"
                            Grid.Column="1"
                            FontFamily="Segoe UI"
                            FontSize="13.5"
                            FontWeight="Bold"
                            Foreground="#38BDF8"
                            Text="0%" />
                    </Grid>

                    <!-- 现代纤细进度条 -->
                    <Border
                        x:Name="ProgressTrack"
                        Grid.Row="1"
                        Height="4"
                        Background="#1E293B"
                        CornerRadius="2"
                        ClipToBounds="True">
                        <Grid>
                            <Rectangle
                                x:Name="ProgressBar"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                RadiusX="2"
                                RadiusY="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#0284C7" />
                                        <GradientStop Offset="0.5" Color="#38BDF8" />
                                        <GradientStop Offset="1" Color="#10B981" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.8" />
                                </Rectangle.Effect>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" CenterX="0" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- 底部精细技术详情字符串（DLL名称/详细初始化参数） -->
                    <TextBlock
                        x:Name="StatusText"
                        Grid.Row="2"
                        Margin="0,7,0,0"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="11"
                        Foreground="#64748B"
                        Text="Loading modules..."
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- ==================== 4. 底部系统指标与版权栏 ==================== -->
                <Border
                    Grid.Row="3"
                    Background="#070A12"
                    BorderBrush="#1E293B"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,17,17"
                    Padding="28,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：底层环境标识 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#475569"
                                Text="HALCON 20.11+ CORE   •   OpenCV 4.10+   •   .NET 10.0 (x64)   •   ACCELERATION READY" />
                        </StackPanel>

                        <!-- 右侧：版权信息 -->
                        <TextBlock
                            Grid.Column="1"
                            FontFamily="Segoe UI"
                            FontSize="10"
                            Foreground="#475569"
                            Text="© 2026 ZeroCode. All Rights Reserved." />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
